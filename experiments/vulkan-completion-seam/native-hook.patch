+// EXACT UNWIRED BOUNDARY: only the private packed owner adapter may call this.
+// It must hold strong Go owner references before entering native code, retain
+// the returned ticket, and publish metadata only after query(COMPLETE). Not a
+// public pointer-registration API. Existing packed synchronous guards stay intact.
+// First operation intentionally only fills an entire fresh packed allocation.
+static int v41CompletionRecordPackedZero(fvk_v41_batch_identity id,
+                                         Buffer* dst, size_t capacity,
+                                         uint64_t* use) {
+    if (!use) return 1;
+    *use = 0;
+    fvk_v41_batch_identity current{};
+    if (fvk_v41_batch_current(&current) || current.generation != id.generation ||
+        current.owner != id.owner || current.serial != id.serial) return 1;
+    // Identity is checked BEFORE dereferencing the private owner's live handle.
+    if (!dst || !capacity || capacity % 288 || dst->bytes != capacity ||
+        !dst->buf || !dst->mem || dst->deviceGeneration != id.generation ||
+        !dst->allocationID || dst->weightArenaBound || dst->offloadPage ||
+        dst->mapped || dst->memoryOffset || dst->allocationBytes < capacity ||
+        g_batchOps == std::numeric_limits<int>::max()) return 2;
+    V41BatchLifetimePrototype::Allocation allocation{
+        dst, dst->deviceGeneration, dst->allocationID, dst->bytes};
+    // Store growth and custody happen before ANY referencing command. An
+    // allocation failure/overlap rejection cannot leave an untracked command.
+    if (!g_completion.enroll(id, {}, allocation, *use)) return 1;
+    recordTransferBarrier(g_batchCmd);
+    vkCmdFillBuffer(g_batchCmd, dst->buf, 0, capacity, 0);
+    recordTransferBarrier(g_batchCmd);
+    ++g_batchOps;
+    g_batchHasV41 = true; // prevents asynchronous generic pipeline submission
+    if (!g_completion.recorded(id, *use)) {
+        g_completion.quarantineRecording((int)VK_ERROR_UNKNOWN);
+        g_submissionStatus = VK_ERROR_UNKNOWN;
+        g_v41SubmissionPendingFailure = true;
+        return (int)VK_ERROR_UNKNOWN;
+    }
+    return 0;

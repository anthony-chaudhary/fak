+// EXPERIMENTAL completion interface. Snapshot/query never flush, drain or submit.
+int fvk_v41_batch_current(fvk_v41_batch_identity* out) {
+    if (!out) return 1;
+    *out = {};
+    if (!completionAdmission() || !g_stepBatch || !g_batching ||
+        g_batchCmd != g_completionCommand || !g_completionWindow.serial) return 1;
+    *out = g_completionWindow;
+    return 0;
+}
+int fvk_v41_batch_query(fvk_v41_batch_identity id,
+                        fvk_v41_batch_phase* phase, int* result) {
+    if (!phase || !result) return 1;
+    *phase = FVK_V41_BATCH_QUARANTINED;
+    *result = (int)VK_ERROR_UNKNOWN;
+    if (id.generation != g_memoryDeviceGeneration) return 1;
+    return g_completion.query(id, *phase, *result) ? 0 : 1;
+}
+int fvk_v41_batch_acknowledge(fvk_v41_batch_identity id, uint64_t use) {
+    // Completion is a historical fence fact, not permission on a failed context.
+    if (g_submissionStatus != VK_SUCCESS || g_v41SubmissionPendingFailure ||
+        !g_memoryDeviceGenerationReady || id.generation != g_memoryDeviceGeneration) return 1;
+    return g_completion.acknowledge(id, use) ? 0 : 1;
+}
+int fvk_v41_batch_forget(fvk_v41_batch_identity id) {
+    return g_completion.forget(id) ? 0 : 1;
+}

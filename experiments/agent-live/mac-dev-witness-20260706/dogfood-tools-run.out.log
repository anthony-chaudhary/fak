package strpad

import strings

// LeftPad pads s on the left with p until it is at least n runes wide.
func LeftPad(s string, n int, p rune) string {
 missing := n - len([]rune(s))
 if missing <= 0 {
 return s
 }
 return strings.Repeat(string(p), missing) + s
}


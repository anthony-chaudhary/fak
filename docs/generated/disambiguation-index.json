    {
      "schema": "fak-disambiguation-entry/1",
      "identity": {
        "canonical_term": "session recovery",
        "aliases": [
          "recovery"
        ]
      },
      "definition": "A bounded repair or reroute response when persisted or cumulative session state cannot safely continue unchanged.",
      "contrasts": [
        {
          "canonical_term": "recovery checkpoint",
          "explanation": "Recovery is the repair action; a recovery checkpoint is the structured continuation state handed to that action.",
          "required_pair": false,
          "forbidden_conflation": true
        },
        {
          "canonical_term": "session resume",
          "explanation": "Recovery responds to corrupt or over-envelope state; resume merely re-admits a valid paused session.",
          "required_pair": true,
          "forbidden_conflation": true
        }
      ],
      "scope": {
        "kind": "runtime",
        "value": "internal/session"
      },

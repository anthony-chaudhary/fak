      "schema": "fak-disambiguation-entry/1",
      "identity": {
        "canonical_term": "recovery checkpoint",
        "aliases": [
          "checkpoint"
        ]
      },
      "definition": "A typed snapshot of goal, pending turn, continuation, generation, and state revision emitted when session recovery is requested.",
      "contrasts": [
        {
          "canonical_term": "context compaction",
          "explanation": "The checkpoint preserves control-plane continuation state; compaction rewrites model-visible history to reduce resident context.",
          "required_pair": true,
          "forbidden_conflation": true
        },
        {
          "canonical_term": "session recovery",
          "explanation": "The checkpoint is evidence and continuation data for recovery, not the repair or reroute action itself.",
          "required_pair": false,
          "forbidden_conflation": true
        }
      ],

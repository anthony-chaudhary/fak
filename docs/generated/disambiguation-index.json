    {
      "schema": "fak-disambiguation-entry/1",
      "identity": {
        "canonical_term": "session resume",
        "aliases": [
          "resume"
        ]
      },
      "definition": "The paused-to-running boundary that re-admits an existing session using warm KV when available or a safe cold re-prefill.",
      "contrasts": [
        {
          "canonical_term": "agent session",
          "explanation": "Resume changes the run state of an existing session; it is not the session identity or transcript.",
          "required_pair": false,
          "forbidden_conflation": true
        },
        {
          "canonical_term": "session recovery",
          "explanation": "Resume continues a valid paused session; recovery repairs or reroutes state that cannot safely continue as-is.",
          "required_pair": true,
          "forbidden_conflation": true
        }
      ],

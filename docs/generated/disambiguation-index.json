          "required_pair": false,
          "forbidden_conflation": true
        },
        {
          "canonical_term": "radix prefix cache",
          "explanation": "A KV cache is one sequence's live attention state; the radix cache indexes token prefixes and references reusable snapshots across requests.",
          "required_pair": true,
          "forbidden_conflation": true

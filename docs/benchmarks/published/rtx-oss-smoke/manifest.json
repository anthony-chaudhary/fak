    {
      "id": "exl3-correctness",
      "executable": "pytest",
      "argv": [
        "tests/kernels/gemm/test_exl3_gemv.py",
        "tests/kernels/gemm/test_exl3_gemm_shapes.py",
        "tests/modules/linear/test_linear_exl3_paths.py",
        "--devices",
        "0",
        "-q"

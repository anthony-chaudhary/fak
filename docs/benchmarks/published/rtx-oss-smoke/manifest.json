  "preflight": [
    "verify exact GPU model, VRAM, driver, idle utilization, power/temperature and lease ownership",
    "verify source revision, binary plus loaded DLL/package/runtime digests; do not equate source study pin with installed executable",
    "verify model/tokenizer/artifact digests, precision, chat template, headroom and actual allocation",
    "semantic fixed prompts before timing; preserve raw output and finish reason",
    "capture effective attention/GEMM backends and offload; initial tail-skip=0 and speculation off",
    "disable prefix reuse for cold-cache comparison using engine controls; empty client prefix does not disable it"
  ],
  "required_receipt_fields": [
    "argv",
    "environment",
    "source_revision",
    "binary_sha256",
    "model_sha256",
    "gpu_name",
    "driver",

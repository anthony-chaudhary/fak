  "arms": [
    {
      "id": "llama-phase",
      "executable": "llama-bench",
      "argv": [
        "-m",
        "${GGUF}",
        "-ngl",
        "99",
        "-p",
        "512",
        "-n",
        "128",
        "-r",
        "3",
        "-o",

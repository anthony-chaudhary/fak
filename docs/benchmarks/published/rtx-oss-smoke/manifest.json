      "gate": "Use source environment; count passes AND skips; requires CUDA runtime matching actual SM120",
      "measurement": "correctness only; endpoint needed for token-time"
    },
    {
      "id": "vllm-latency",
      "executable": "vllm",
      "argv": [
        "bench",
        "latency",
        "--model",
        "${HF_MODEL}",
        "--dtype",
        "bfloat16",
        "--max-model-len",
        "2048",
        "--gpu-memory-utilization",
        "0.75",
        "--batch-size",
        "1",
        "--input-len",
        "512",
        "--output-len",
        "128",
        "--num-iters-warmup",
        "1",
        "--num-iters",
        "3",
        "--output-json",
        "${OUTPUT}"
      ],
      "measurement": "whole-batch synthetic latency; not TTFT or standalone decode"
    },
    {
      "id": "sglang-latency",
      "executable": "python",
      "argv": [
        "-m",
        "sglang.benchmark.one_batch",
        "--model-path",
        "${HF_MODEL}",
        "--dtype",
        "bfloat16",
        "--batch-size",
        "1",
        "--input-len",
        "512",
        "--output-len",
        "128",
        "--result-filename",
        "${OUTPUT}"
      ],
      "measurement": "native synthetic phases; invoke 3 independent arms after documented warmup"
    }

  ],
  "rules": [
    "unknown counters remain null; no SSE-event rate labeled token throughput",
    "no cross-format speedup without quality/envelope labels",
    "HTTP runner supports SGLang/vLLM labels only; never mislabel another engine",
    "no native bench alone establishes semantic correctness",
    "microbenchmarks are distinct from request latency and agentic replay",
    "no percent delta without measured comparable nonzero baseline"
  ]

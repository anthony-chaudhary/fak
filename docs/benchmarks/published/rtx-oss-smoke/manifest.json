        "fp8",
        "--warmup",
        "1",
        "-r",
        "3",
        "-o",
        "json",
        "--output-file",
        "${OUTPUT}"
      ],
      "gate": "Linux/Windows build contract per note; SM120a; plain first; approximation disabled; no speculation without companion weights"

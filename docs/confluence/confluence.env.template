# Confluence publishing credentials — TEMPLATE (placeholder values only, safe to commit).
#
# To use: copy this to a gitignored `.env.confluence.local` at the repo root ON THE BRIDGE
# MACHINE (the internal bridge), fill in the real token, and `source` it (or export the vars) before
# running `confluence push|pull|status`. NEVER commit the real token; NEVER paste it into a
# shared channel or log. Rotate it if exposed.
#
#   cp docs/confluence/confluence.env.template .env.confluence.local
#   # edit .env.confluence.local, then:
#   set -a; . ./.env.confluence.local; set +a

# Required: Confluence personal access token (Bearer). Placeholder — replace on the bridge.
CONFLUENCE_TOKEN=replace-me-on-the-bridge-machine

# Optional: Confluence base URL. Default below is the tool's built-in; override only if needed.
CONFLUENCE_URL=http://<internal-confluence-host>:8090/

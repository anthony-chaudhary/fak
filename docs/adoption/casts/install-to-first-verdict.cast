{"version": 2, "width": 84, "height": 30, "timestamp": 1751673600, "title": "fak: install to first DENY verdict (no key, no model, no GPU)", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.5, "o", "# fak: from a clean clone to a real capability verdict — no key, no model, no GPU.\r\n"]
[2.2, "o", "# Step 1/3 — build the one static Go binary (Go 1.26+, no go.sum, no deps).\r\n"]
[3.6, "o", "$ go build -o fak ./cmd/fak\r\n"]
[7.9, "o", "$ ls -lh fak\r\n"]
[8.3, "o", "-rwxr-xr-x  1 you  staff   44M  fak\r\n"]
[9.6, "o", "\r\n# Step 2/3 — ask the kernel to preflight a dangerous tool call. Nothing runs;\r\n"]
[10.4, "o", "# the capability floor decides at the boundary, structurally, with no model.\r\n"]
[11.8, "o", "$ ./fak preflight --tool refund_payment --args \"{}\"\r\n"]
[12.6, "o", "verdict=DENY reason=DEFAULT_DENY by=monitor\r\n"]
[13.4, "o", "#  ^ refund_payment is not on the allow-list, so the kernel fails closed.\r\n"]
[13.8, "o", "#    This is the first verdict: a DENY you can see in one command.\r\n"]
[15.2, "o", "\r\n# Step 3/3 — contrast: an allow-listed read is admitted, same code path.\r\n"]
[16.4, "o", "$ ./fak preflight --tool get_user_details --args \"{}\"\r\n"]
[17.1, "o", "verdict=ALLOW reason=NONE by=monitor\r\n"]
[18.5, "o", "\r\n# That's the whole boundary: default-deny, fail-closed, model-independent.\r\n"]
[19.3, "o", "# Same binary next wraps your agent:  fak manage -- claude\r\n"]
[21.0, "o", "$ \r\n"]

{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "instructions": ["CONTRIBUTING.md", "AGENTS.md"],
  "skills": {
    "paths": [".agents/skills"]
  },
  "agent": {
    "general": {
      "variant": "default"
    },
    "explore": {
      "variant": "default"
    },
    "deep-reason": {
      "variant": "high",
      "description": "High-reasoning subagent for deep architectural analysis, frozen ABI changes, or complex debugging"
    }
  },
  "mcp": {
    "dos": {
      "type": "local",
      "command": ["dos-mcp"],
      "environment": {
        "PYTHONIOENCODING": "utf-8"
      },
      "enabled": true
    },
    "fak": {
      "type": "local",
      "command": ["fak", "serve", "--stdio", "--defer-tools=true", "--policy", "examples/opencode-policy.json"],
      "environment": {},
      "enabled": true
    }
  },
  "lsp": {
    "gopls": {
      "disabled": true
    },
    "fak-go": {
      "command": ["fak", "lsp"],
      "extensions": [".go"]
    }
  },
  "permission": {
    "skill": {
      "phased-plan": "deny"
    },
    "lsp": "allow",
    "fak*": "allow",
    "dos*": "allow",
    "fak_*": "allow",
    "dos_*": "allow"
  }
}

# /etc/fak/fak.env — root-only environment file for fak.service.
# COPY, DON'T RETYPE:
#   sudo cp deploy/systemd/fak.env.example /etc/fak/fak.env
#   sudo chown root:root /etc/fak/fak.env && sudo chmod 600 /etc/fak/fak.env
# then fill in the secret values below.
#
# Values here are SECRET placeholders. The unit file references variable NAMES
# only (--require-key-env, --api-key-env); never put a key on an ExecStart line.

# Bearer token REQUIRED on every request except /healthz (--require-key-env).
# Generate one with: openssl rand -hex 32
FAK_GATEWAY_KEY=

# Upstream provider key named by the unit's --api-key-env OPENAI_API_KEY.
OPENAI_API_KEY=

# Generous timeouts for long model turns (seconds).
FAK_HTTP_WRITE_TIMEOUT_S=300
FAK_PLANNER_TIMEOUT_S=300

# Tamper-evident audit journal. StateDirectory=fak in the unit provides
# /var/lib/fak writable to the DynamicUser; keep the journal inside it.
FAK_AUDIT_JOURNAL=/var/lib/fak/audit.jsonl

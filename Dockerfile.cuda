# Dockerfile.cuda — the in-kernel GPU-serving image (#2661).
#
# Companion to the default `Dockerfile` (which stays the lean, GPU-free distroless
# static image for proxy mode and remains available under explicit CPU tags). This image adds a CUDA
# runtime so `fak serve --gguf ... --engine inkernel --backend cuda` can bind a
# rented GPU on a neo cloud (CoreWeave / Lambda / Crusoe / RunPod / Vast) or a
# local box with the NVIDIA Container Toolkit installed.
#
#   docker build -f Dockerfile.cuda -t fak:cuda .
#   docker run --rm --gpus all -p 8080:8080 fak:cuda \
#       serve --addr 0.0.0.0:8080 --gguf /models/model.gguf \
#       --engine inkernel --backend cuda
#
# Compute-capability floor: with --build-arg CUDA_ARCH unset the builder compiles
# internal/compute's CUDA kernels for EVERY arch in the authoritative
# internal/compute/cuda_arch.txt — emitting sm_120f for Blackwell consumer
# (RTX 50-series / SM12x) so native NVFP4 W4A4 prefill is compiled in instead of
# silently falling back to int8 — plus a compute_<last> PTX floor. Passing
# CUDA_ARCH narrows the build to that one arch (accepting sm_90+ 'a' and
# sm_100+ 'f' suffixes whose base arch is in cuda_arch.txt):
#   docker build -f Dockerfile.cuda --build-arg CUDA_ARCH=sm_120f -t fak:cuda .
#
# CUDA 12.9 (the first toolkit that emits sm_103 for B300) is pinned to match the toolchain internal/compute/setup_cuda_wsl.sh
# and .github/workflows/cuda-build.yml already build and test against, so the
# runtime this image ships is the SAME toolkit line the CUDA CI already covers,
# not an untested newer/older one. The NVIDIA base images refuse to start on a host driver
# older than the toolkit needs (R575+ for 12.9).
#
# Override APP_VERSION at build time to stamp a specific version into the binary:
#   docker build -f Dockerfile.cuda --build-arg APP_VERSION=0.36.0 -t fak:0.36.0-cuda .

# --- builder -------------------------------------------------------------------
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04 AS build
ARG APP_VERSION=docker
ARG CUDA_ARCH=

# The -devel image lacks git/build-essential/Go by default (same toolchain gap
# .github/workflows/cuda-build.yml's nvcc job fills).
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
ARG GO_VERSION=1.26.0
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /src
COPY . .
RUN if [ -n "${CUDA_ARCH}" ]; then \
      base="${CUDA_ARCH%[af]}"; suffix="${CUDA_ARCH#"$base"}"; cc="${base#sm_}"; \
      if ! grep -Fxq "${base}" internal/compute/cuda_arch.txt \
         || { [ "${suffix}" = "a" ] && [ "${cc}" -lt 90 ]; } \
         || { [ "${suffix}" = "f" ] && [ "${cc}" -lt 100 ]; }; then \
        echo "unsupported CUDA_ARCH ${CUDA_ARCH} (base must be in cuda_arch.txt; a requires sm_90+, f requires sm_100+)"; \
        cat internal/compute/cuda_arch.txt; exit 2; \
      fi; \
    fi

# Compile the kernels with the build-cuda legacy driver's exact flags (same nvcc invocation the CI
# nvcc job runs), then cgo-link the version-stamped -tags cuda binary against the
# resident archive + this image's cudart/cublas libs. In the fat build, emit sm_120f
# for Blackwell consumer (SM12x) so RTX 50-series GPUs run native NVFP4 W4A4 prefill
# while keeping the compute_120 PTX floor for forward JIT compatibility.
RUN cd internal/compute \
    && if [ -n "${CUDA_ARCH}" ]; then \
         cc="${CUDA_ARCH#sm_}"; gencode="-gencode arch=compute_${cc},code=${CUDA_ARCH}"; \
       else \
         gencode=""; while read -r arch; do \
           cc="${arch#sm_}"; \
           if [ "${arch}" = "sm_120" ]; then \
             gencode="$gencode -gencode arch=compute_120f,code=sm_120f"; \
           else \
             gencode="$gencode -gencode arch=compute_${cc},code=${arch}"; \
           fi; \
         done < cuda_arch.txt; \
         gencode="$gencode -gencode arch=compute_${cc},code=compute_${cc}"; \
       fi \
    && nvcc -O3 -std=c++17 $gencode -ccbin g++ -Xcompiler -fPIC -c cuda_kernels.cu -o cuda_kernels.o \
    && ar rcs libfakcuda.a cuda_kernels.o
ENV CGO_ENABLED=1 \
    CGO_CFLAGS="-I/usr/local/cuda/include" \
    CGO_LDFLAGS="-L/src/internal/compute -L/usr/local/cuda/lib64"
# Build through the one canonical release recipe (scripts/build.sh, #3709) with the
# cuda tag; this stage's ENV (CGO_ENABLED=1 + the cgo cuda flags above) passes through.
RUN OUT=/out/fak VERSION="${APP_VERSION}" TAGS=cuda GOTOOLCHAIN=auto sh scripts/build.sh

# --- runtime -------------------------------------------------------------------
# -runtime (not -base): carries cudart/cublas so the binary's dynamic links resolve;
# the NVIDIA Container Toolkit injects libcuda.so + the driver at `docker run --gpus`.
FROM nvidia/cuda:12.9.1-runtime-ubuntu22.04
LABEL io.modelcontextprotocol.server.name="io.github.anthony-chaudhary/fak"
RUN groupadd -r fak && useradd -r -g fak -d /nonexistent -s /usr/sbin/nologin fak
COPY --from=build /out/fak /usr/local/bin/fak
# Notice files ship inside the image so redistributors can satisfy the
# license notice terms (#14447).
COPY LICENSE NOTICE.md THIRD_PARTY_NOTICES.md /usr/share/doc/fak/
USER fak
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/fak"]
# Default to the gateway bound to all interfaces (containers need 0.0.0.0, not
# loopback). Override the whole command to add --gguf/--engine inkernel/--backend
# cuda, or run `agent`, `policy`, etc.
CMD ["serve", "--addr", "0.0.0.0:8080"]

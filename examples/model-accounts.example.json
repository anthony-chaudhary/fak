{
  "version": "fak-accounts/v1",
  "accounts": [
    {
      "id": "local",
      "kind": "local",
      "base_url": "http://127.0.0.1:11434/v1",
      "label": "on-box ollama / vLLM (OpenAI-compatible) — no key, residency-exempt"
    },
    {
      "id": "corp-glm",
      "kind": "fleet",
      "base_url": "http://glm.infer.corp.internal:8000/v1",
      "label": "zone=fleet — a GLM-5.2 vLLM server the COMPANY operates. Self-hosted (its tokens count as saved) but still OFF-BOX, so the residency floor treats it as remote until an operator declares a trust boundary. No cred_env needed on a private network; add one if the endpoint authenticates."
    },
    {
      "id": "corp-kimi",
      "kind": "fleet",
      "base_url": "http://kimi.infer.corp.internal:8000/v1",
      "cred_env": "CORP_INFER_TOKEN",
      "label": "zone=fleet — a Kimi-K3 server on company GPUs, behind a shared bearer token named (never pasted) here"
    },
    {
      "id": "openai-personal",
      "kind": "openai",
      "cred_env": "OPENAI_API_KEY",
      "label": "your personal OpenAI account"
    },
    {
      "id": "openai-work",
      "kind": "openai",
      "cred_env": "OPENAI_WORK_API_KEY",
      "label": "a SECOND OpenAI account — the switch: same provider kind, a different credential"
    },
    {
      "id": "codex",
      "kind": "openai-responses",
      "cred_env": "OPENAI_API_KEY",
      "label": "OpenAI Responses API — codex's native wire (NOT plain chat-completions)"
    },
    {
      "id": "claude-sub",
      "kind": "anthropic",
      "cred_env": "CLAUDE_CODE_OAUTH_TOKEN",
      "label": "your Anthropic Pro/Max subscription (an sk-ant-oat token; the Bearer + oauth-2025-04-20 beta header is applied by the dispatch adapter, not by the roster)"
    },
    {
      "id": "july6netra_groq",
      "kind": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "cred_env": "FAK_GROQ_API_KEY",
      "requests_per_minute": 30,
      "requests_per_day": 1000,
      "tokens_per_minute": 8000,
      "tokens_per_day": 200000,
      "label": "Groq OpenAI-compatible account for Alibaba Cloud Qwen3.6 27B; set the key in FAK_GROQ_API_KEY, never in this file"
    },
    {
      "id": "july6netra_groq_compound",
      "kind": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "cred_env": "FAK_GROQ_API_KEY",
      "requests_per_minute": 30,
      "requests_per_day": 250,
      "label": "Groq OpenAI-compatible account for groq/compound lower-quality tier; request-count limited, no token cap recorded"
    },
    {
      "id": "gemini",
      "kind": "gemini",
      "cred_env": "GEMINI_API_KEY",
      "label": "your Google Gemini account (native generativelanguage wire, AI Studio key)"
    },
    {
      "id": "gemini-gcp-vertex",
      "kind": "openai",
      "base_url": "https://us-central1-aiplatform.googleapis.com/v1beta1/projects/YOUR_GCP_PROJECT/locations/us-central1/endpoints/openapi",
      "cred_env": "FAK_GEMINI_GCP_KEY",
      "label": "Gemini on your GCP account via Vertex AI's OpenAI-compatible endpoint; the bearer in FAK_GEMINI_GCP_KEY is a GCP access token ($(gcloud auth print-access-token)). This is the seat the claude-gemini-gcp launcher fronts — see docs/fak/claude-gemini-gcp.md"
    },
    {
      "id": "deepseek",
      "kind": "deepseek",
      "cred_env": "DEEPSEEK_API_KEY",
      "context_tokens": 1000000,
      "max_output_tokens": 384000,
      "label": "DeepSeek V4 OpenAI-compatible API at https://api.deepseek.com; 1M context, 384K max output"
    },
    {
      "id": "deepseek-anthropic",
      "kind": "anthropic",
      "base_url": "https://api.deepseek.com/anthropic",
      "cred_env": "DEEPSEEK_API_KEY",
      "context_tokens": 1000000,
      "max_output_tokens": 384000,
      "label": "DeepSeek V4 Anthropic-compatible API; visible in acceptance but not probed as OpenAI /models"
    }
  ],
  "default": "openai-personal",
  "bindings": [
    { "model": "small", "account": "local", "upstream_model": "llama3.2" },
    { "model": "zone-device", "account": "local", "upstream_model": "qwen/qwen3.6-4b" },
    { "model": "zone-fleet", "account": "corp-glm", "upstream_model": "glm-5.2" },
    { "model": "zone-fleet-agentic", "account": "corp-kimi", "upstream_model": "kimi-k3" },
    { "model": "medium", "account": "openai-personal", "upstream_model": "gpt-5.5" },
    { "model": "large", "account": "claude-sub", "upstream_model": "claude-opus-4-6" },
    { "model": "guard-a", "account": "openai-work", "upstream_model": "gpt-5.5" },
    { "model": "guard-b", "account": "claude-sub", "upstream_model": "claude-opus-4-6" },
    { "model": "qwen36-groq", "account": "july6netra_groq", "upstream_model": "qwen/qwen3.6-27b" },
    { "model": "groq-compound", "account": "july6netra_groq_compound", "upstream_model": "groq/compound" },
    { "model": "drafter-a", "account": "openai-personal", "upstream_model": "gpt-5.5" },
    { "model": "drafter-b", "account": "gemini", "upstream_model": "gemini-3-pro" },
    { "model": "gemini-flash", "account": "gemini-gcp-vertex", "upstream_model": "google/gemini-3.5-flash" },
    { "model": "judge", "account": "claude-sub", "upstream_model": "claude-opus-4-6" },
    { "model": "tiny-classifier", "account": "local", "upstream_model": "llama3.2" },
    { "model": "deepseek-pro", "account": "deepseek", "upstream_model": "deepseek-v4-pro" },
    { "model": "deepseek-flash", "account": "deepseek", "upstream_model": "deepseek-v4-flash" },
    { "model": "deepseek-pro-anthropic", "account": "deepseek-anthropic", "upstream_model": "deepseek-v4-pro" },
    {
      "model": "deepseek-chat-compat",
      "account": "deepseek",
      "upstream_model": "deepseek-chat",
      "compatibility_only": true,
      "deprecated_after_utc": "2026-07-24 15:59 UTC",
      "deprecated_alias_for": "deepseek-v4-flash non-thinking mode"
    },
    {
      "model": "deepseek-reasoner-compat",
      "account": "deepseek",
      "upstream_model": "deepseek-reasoner",
      "compatibility_only": true,
      "deprecated_after_utc": "2026-07-24 15:59 UTC",
      "deprecated_alias_for": "deepseek-v4-flash thinking mode"
    }
  ]
}

# Reproduce the Inkling-2-Mini pp512 benchmark on a CUDA sm_120f build.
# The 640-token cap belongs to the fixed benchmark workload. Normal serving sizes context separately.
FAK_INKLING2_SERVE_BATCH=1
FAK_INKLING2_BATCHED_PREFILL=1
FAK_INKLING2_COHORT_PREFILL=1
FAK_INKLING2_BATCH_KV=f16
FAK_INKLING2_COHORT_PREFILL_KV=f16
FAK_INKLING2_BATCH_GAP=25ms
FAK_INKLING2_BATCH_WAIT=75ms
FAK_INKLING2_CTX=640
FAK_INKLING2_BATCH_PREFIX_CACHE_MIB=0
FAK_CUDA_TIMESTAMP_PROFILE=0

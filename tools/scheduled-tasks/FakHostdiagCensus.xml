<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Privacy-safe fak process census every five minutes for later Windows resource-event correlation.</Description>
    <URI>\FakHostdiagCensus</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>%FLEET_TASK_USER_SID%</UserId>
      <LogonType>S4U</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-08-27T03:00:00-07:00</StartBoundary>
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>%USERPROFILE%\bin\fak.exe</Command>
      <Arguments>hostdiag census --ledger "%LOCALAPPDATA%\fak-hostdiag\hostdiag.jsonl" --max-bytes 16777216</Arguments>
    </Exec>
  </Actions>
</Task>

        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Top Invocations by Integration",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (integration) (rate(fak_harness_tool_calls_total{integration=~\"$integration\"}[1m])) * 60",
          "legendFormat": "{{integration}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },

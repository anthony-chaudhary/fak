      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum(rate(fak_harness_tool_auth_cache_hits_total[1m])) / (sum(rate(fak_harness_tool_auth_cache_hits_total[1m])) + sum(rate(fak_harness_tool_jit_secret_pages_total[1m])))) * 100 or vector(100)",
          "legendFormat": "Hit Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },

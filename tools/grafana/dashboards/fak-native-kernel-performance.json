    {
      "id": 9,
      "title": "Phase time / request — largest bar is the bottleneck",
      "description": "Receipt-projected queue, prefill, decode, and kernel seconds normalized by supported native requests.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "index": 0,
                  "text": "UNAVAILABLE",
                  "color": "dark-red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "text": {}
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_native_receipt_phase_seconds_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\",phase=\"queue\"}[$__rate_interval])) / clamp_min(sum(rate(fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\"}[$__rate_interval])), 0.000001)) or vector(-1)",
          "refId": "A",
          "legendFormat": "queue / request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_native_receipt_phase_seconds_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\",phase=\"prefill\"}[$__rate_interval])) / clamp_min(sum(rate(fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\"}[$__rate_interval])), 0.000001)) or vector(-1)",
          "refId": "B",
          "legendFormat": "prefill / request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_native_receipt_phase_seconds_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\",phase=\"decode\"}[$__rate_interval])) / clamp_min(sum(rate(fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\"}[$__rate_interval])), 0.000001)) or vector(-1)",
          "refId": "C",
          "legendFormat": "decode / request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_native_receipt_phase_seconds_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\",phase=\"kernel\"}[$__rate_interval])) / clamp_min(sum(rate(fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\"}[$__rate_interval])), 0.000001)) or vector(-1)",

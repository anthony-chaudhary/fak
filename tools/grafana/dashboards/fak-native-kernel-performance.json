      "id": 9,
      "title": "Phase time / request \u2014 largest bar is the bottleneck",
      "description": "Existing queue/prefill/decode totals are normalized by native request rate. Transfer and kernel series are proposed bounded contract names and remain UNAVAILABLE until exported. Fixture renders are evidence of dashboard behavior, not live wiring.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "index": 0,
                  "text": "UNAVAILABLE",
                  "color": "dark-red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "text": {}
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_gateway_inference_queue_seconds_total{engine=~\"$engine\",model=~\"$model\"}[$__rate_interval])) / clamp_min(sum(rate(fak_gateway_inference_requests_total{engine=~\"$engine\",model=~\"$model\"}[$__rate_interval])), 0.000001)) or vector(-1)",
          "refId": "A",
          "legendFormat": "queue / request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_gateway_inference_prefill_seconds_total{engine=~\"$engine\",model=~\"$model\"}[$__rate_interval])) / clamp_min(sum(rate(fak_gateway_inference_requests_total{engine=~\"$engine\",model=~\"$model\"}[$__rate_interval])), 0.000001)) or vector(-1)",
          "refId": "B",
          "legendFormat": "prefill / request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fak_gateway_inference_decode_seconds_total{engine=~\"$engine\",model=~\"$model\"}[$__rate_interval])) / clamp_min(sum(rate(fak_gateway_inference_requests_total{engine=~\"$engine\",model=~\"$model\"}[$__rate_interval])), 0.000001)) or vector(-1)",
          "refId": "C",
          "legendFormat": "decode / request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(fak_native_transfer_seconds_per_request{engine=~\"$engine\",model=~\"$model\"}) or vector(-1)",

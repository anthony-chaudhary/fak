        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(fak_engine_model_info{engine=~\"$engine\",model=~\"$model\"}) or vector(-1)",
          "refId": "A"
        }
      ]
    },

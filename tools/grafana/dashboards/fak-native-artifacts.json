{
  "annotations": {
    "list": []
  },
  "description": "Live fak-native receipt evidence and freshness. Prometheus intentionally does not expose per-artifact correlation keys or locators, so this dashboard does not fabricate artifact links.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 13,
        "w": 18,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (backend, forward_path) (fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\",forward_path=~\"$forward_path\"})",
          "instant": true,
          "legendFormat": "{{backend}} · {{forward_path}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Observed native receipt streams",
      "type": "table",
      "description": "Cumulative supported fak-native receipts by bounded backend and forward path. No request, artifact, or model identifier is used as a label."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "index": 0,
                  "text": "FRESH",
                  "color": "green"
                },
                "1": {
                  "index": 1,
                  "text": "STALE",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 2,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "fak_native_receipt_latest_stale",
          "instant": true,
          "legendFormat": "receipt evidence",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Receipt evidence freshness",
      "type": "stat",
      "description": "1 means the latest native receipt is absent or older than the emitter freshness bound; 0 means fresh."
    },
    {
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "id": 3,
      "options": {
        "content": "### Honest drill-down\n- Receipt series prove observed fak-native execution only.\n- Backend and forward-path labels use bounded emitter vocabularies.\n- Exact artifact keys and locators stay in the scrubbed artifact index, not Prometheus.\n- Stale or unsupported evidence is shown explicitly; missing device data is never zero-filled.",
        "mode": "markdown"
      },
      "title": "Evidence guardrails",
      "type": "text"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "fak",
    "native-performance",
    "artifacts"
  ],

    {
      "type": "stat",
      "title": "Exporter up (1 = collecting)",
      "description": "Prometheus reachability of the Fak Ops statuses exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"fak_ops\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "range": false,
          "instant": true

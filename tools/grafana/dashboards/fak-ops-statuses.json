      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"fak_ops\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true

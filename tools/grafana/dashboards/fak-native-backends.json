    {
      "id": 2,
      "title": "Native requests / second",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Supported non-fallback native receipts by bounded backend and forward path.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (backend, forward_path) (rate(fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\"}[5m]))",
          "legendFormat": "{{backend}} · {{forward_path}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },

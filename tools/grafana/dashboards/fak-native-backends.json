  "panels": [
    {
      "id": 1,
      "title": "Synthetic fixture notice",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## fak-native backend drilldowns\nThis dashboard accepts only bounded **fak-native** Metal/CUDA telemetry. The committed fixture is **synthetic deterministic render evidence, not live performance evidence**. Live model-specific witnesses must name **Qwen3.8**. Missing backends render an explicit reason; measurements are omitted rather than shown as zero or replaced by another engine."
      }
    },
    {
      "id": 2,
      "title": "Backend identity",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Bounded engine/model-family identity. llama.cpp and auto fallback identities are outside the contract.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "fak_native_backend_info{backend=~\"$backend\",engine=\"fak-native\"} == 1",
          "legendFormat": "{{backend}} \u00b7 {{engine}} \u00b7 {{model_family}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "title": "Explicit backend-unavailable reason",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Empty only when all selected backends are available. Never interpret absence of measurements as zero.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "fak_native_backend_available{backend=~\"$backend\",reason!=\"none\"} == 1",
          "legendFormat": "{{backend}} unavailable: {{reason}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 4,
      "title": "Device utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Active accelerator utilization from the native backend; aligned with #9784 hardware-utilization semantics.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * fak_native_backend_device_utilization_ratio{backend=~\"$backend\"} and on(backend) (fak_native_backend_available{backend=~\"$backend\",reason=\"none\"} == 1)",
          "legendFormat": "{{backend}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

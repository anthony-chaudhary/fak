    {
      "id": 4,
      "title": "Queue time / native request",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cumulative receipt phase=queue seconds normalized by supported native request rate.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (backend, forward_path) (rate(fak_native_receipt_phase_seconds_total{engine=\"inkernel\",backend=~\"$backend\",phase=\"queue\"}[5m])) / clamp_min(sum by (backend, forward_path) (rate(fak_native_receipt_requests_total{engine=\"inkernel\",backend=~\"$backend\"}[5m])), 0.000001)",

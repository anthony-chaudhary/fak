{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "fleet-prometheus"
        },
        "enable": true,
        "expr": "changes(fak_native_lifecycle_event_info{engine=\"fak-native\",benchmark_envelope=~\"$benchmark_envelope\",model=~\"$model\",backend=~\"$backend\"}[1m]) > 0",
        "iconColor": "yellow",
        "name": "promotion \u00b7 revert \u00b7 release",
        "step": "1m",
        "tagKeys": "event,release,module_rev,benchmark_envelope,model,backend",
        "textFormat": "{{event}} {{release}} \u00b7 {{module_rev}} \u00b7 {{benchmark_envelope}} \u00b7 {{model}}/{{backend}}",
        "titleFormat": "fak-native lifecycle"
      }
    ]
  },
  "description": "Matched-envelope fak-native regression SLOs for Qwen3.8. Missing data is UNAVAILABLE, never zero. Synthetic scenarios prove good, regression, missing-evidence, and recovery states.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Native kernel performance",
      "tooltip": "Phase and device drilldown",
      "type": "link",
      "url": "/d/fak-native-kernel-performance"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLO state",
      "description": "Debounced state: good, regression, or missing evidence. Two consecutive complete observations are required for regression and recovery.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "GOOD"
                },
                "2": {
                  "color": "orange",
                  "index": 2,
                  "text": "MISSING EVIDENCE"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "REGRESSION"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "UNAVAILABLE",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "editorMode": "code",
          "expr": "max((fak_native_slo_state{engine=\"fak-native\",scenario=~\"$scenario\",benchmark_envelope=~\"$benchmark_envelope\",model=~\"$model\",backend=~\"$backend\",state=\"good\"} == 1) * 0) or max((fak_native_slo_state{engine=\"fak-native\",scenario=~\"$scenario\",benchmark_envelope=~\"$benchmark_envelope\",model=~\"$model\",backend=~\"$backend\",state=\"regression\"} == 1) * 1) or max((fak_native_slo_state{engine=\"fak-native\",scenario=~\"$scenario\",benchmark_envelope=~\"$benchmark_envelope\",model=~\"$model\",backend=~\"$backend\",state=\"missing_evidence\"} == 1) * 2)",
          "instant": true,
          "legendFormat": "SLO state",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Matched benchmark envelope",
      "description": "Every comparison is keyed by module@rev, benchmark envelope, Qwen3.8 model, and fak-native backend.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "UNAVAILABLE"
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (module_rev, benchmark_envelope, model, backend) (fak_native_slo_state{engine=\"fak-native\",scenario=~\"$scenario\",benchmark_envelope=~\"$benchmark_envelope\",model=~\"$model\",backend=~\"$backend\"})",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ]
    },

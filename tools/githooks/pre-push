#!/bin/sh
# fleet claim-honesty gate  --  DOS reason: CLAIM_UNWITNESSED
#
# Runs `dos review` over exactly the commits this push would add to the trunk
# (origin/<trunk>..HEAD) and surfaces any RESIDUAL — a commit whose subject makes
# a claim (`feat`/`fix`/`test`/...) that the diff could NOT witness (a `test():`
# touching zero _test.go files, a `fix():` touching zero source, ...). This is fak
# applying its OWN thesis to its OWN development: don't believe the commit message,
# verify the claim against the file set git itself recorded.
# The echoed review surface is residual-first: RESIDUAL is the operator work-list,
# CLEARED is the near-zero-attention band for claims the kernel already witnessed.
#
# Why a git hook (not just a CLAUDE.md line): git runs it BELOW the agent layer, so
# the same floor binds Claude Code, Codex, and a human at the push boundary — the
# cross-agent enforcement a doc sentence cannot give. It is the push-time complement
# to the pre-commit leak-scan guard, and the local stand-in for the `dos review`
# CI gate (docs/358) while CI is billing-blocked on the private repo.
#
# Mode  (env FLEET_REVIEW_GUARD):  block (default) | warn | off
#   block  refuse the push until the residual is witnessed/amended  (exit 1)
#   warn   allow the push, print the residual + how to fix it      (exit 0)
#   off    do nothing
# Default is BLOCK: false "done" is refused at the ship seam, while `dos review`
# still renders the residual band first so human attention goes only to claims the
# witness could not clear. Soften with FLEET_REVIEW_GUARD=warn while settling an
# intentional false positive.
#
# Escape hatch:  FLEET_ALLOW_RESIDUAL=1 git push   always allows (e.g. an
# intentional data-artifact commit whose `test()` subject is a known false-positive;
# prefer fixing the subject — a JSON result drop is a `docs(...)`/`chore(...)`, not a `test`).
#
# Fail-open by design: if the `dos` CLI or the trunk ref is unavailable, the hook
# says so and allows the push — a missing verifier must never wedge the trunk.

mode="${FLEET_REVIEW_GUARD:-block}"

# Only gate pushes of the trunk itself; a topic branch / tag push is not the shared
# floor this guard protects.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || exit 0
# Trunk is `main`; `master` stays allowlisted as the legacy alias (the private
# repo still trunks on master, and these hooks are shared across both copies).
case "$branch" in
	main|master) : ;;
	*) exit 0 ;;
esac

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# Capture Git's standard update rows before any child can consume stdin. Build
# evidence below is bound to each immutable local SHA actually being pushed.
push_updates="$(cat)"
pushed_tips="$(printf '%s\n' "$push_updates" | awk 'NF >= 4 && $2 !~ /^0+$/ { print $2 }' | sort -u)"

# The architest tier table must not drift between pushes. GitHub Actions can report
# TestEveryPackageDeclaresTier red after a direct push, but the local push boundary is
# the earliest in-repo place to refuse the same recurrence (#1145). Use `fak hygiene`
# instead of `go test` so native Windows clones avoid the OS test-binary block noted in
# AGENTS.md. As with the claim review below, a missing runner fails open rather than
# wedging a fresh clone.
tier_mode="${FLEET_TIER_GUARD:-block}"
if [ "$tier_mode" != "off" ] && [ "${ALLOW_TIER_DRIFT:-0}" != "1" ]; then
	if command -v fak >/dev/null 2>&1; then
		tier_out="$(fak hygiene --root "$root" --gates TIER_DECLARED 2>&1)"
		tier_status=$?
	elif command -v go >/dev/null 2>&1; then
		tier_out="$(cd "$root" && go run ./cmd/fak hygiene --root "$root" --gates TIER_DECLARED 2>&1)"
		tier_status=$?
	else
		tier_out="neither 'fak' nor 'go' is on PATH"
		tier_status=2
	fi

	if [ "$tier_status" -eq 1 ]; then
		if [ "$tier_mode" = "block" ]; then
			echo "TIER_DECLARED (blocked): architest tier table drift would red the trunk." >&2
			echo "$tier_out" >&2
			echo "  fix: add the missing tier row or remove the stale row in internal/architest/architest_test.go." >&2
			echo "  override once: ALLOW_TIER_DRIFT=1 git push   (intentional false-positive only)" >&2
			exit 1
		else
			echo "TIER_DECLARED (advisory): architest tier table drift detected." >&2
			echo "$tier_out" >&2
		fi
	elif [ "$tier_status" -ne 0 ]; then
		echo "TIER_DECLARED (warn): tier drift gate could not run; push allowed." >&2
		echo "$tier_out" >&2
	fi
fi

# Compile-integrity gate (#1338)  --  reason: TRUNK_WOULD_NOT_COMPILE
#
# Would the commits this push ADDS still build for every peer's shared `go build` graph?
# `dos arbitrate` makes edits ownership-disjoint, not BUILD-disjoint: Go compiles at package
# granularity over one module graph, so a caller landing ahead of its callee (`undefined: X`)
# or a removed exported symbol an importer still calls reds `go build` for unrelated sessions.
# Nothing else at the commit/push seam compiles anything (the other hooks + `fak commit` run
# only content gates; `make ci`'s `go build ./...` is CI/manual), so this is the earliest place
# such a break is caught before it reaches origin and poisons every peer that fetches. `fak
# hooks pre-push` builds the pushed tip's changed packages + their importer closure in an
# ISOLATED archive checkout (immune to the peer-dirty working tree).
#
# Mode (env FLEET_BUILD_GUARD):  block (default) | warn | off
#   warn   allow the push, print the build error + how to fix it   (exit 0)  — explicit advisory override
#   block  refuse the push until the pushed tip compiles           (exit 1)
#   off    do nothing
# Escape:  FLEET_ALLOW_BUILD_BREAK=1 git push   always allows.
# Default is BLOCK for a positively witnessed red pushed tree. Infrastructure/UNKNOWN failures remain fail-open below.
# Fail-open by design: if `fak`/`go` is unavailable or the gate could-not-run, the push is allowed.
build_mode="${FLEET_BUILD_GUARD:-block}"

# Import-witness pre-rung (#1325)  --  reason: IMPORT_OF_UNCOMMITTED_PACKAGE
#
# The cheapest, most common shape of TRUNK_WOULD_NOT_COMPILE below: a committed caller whose
# callee package was never `git add`ed (its dir has zero tracked non-test .go). The full
# compile-integrity gate already catches this, but only via a slow archive `go build` with an
# opaque `undefined`/`no required module` error. This structural pre-check reads ONLY the
# committed tip (git ls-tree + one git grep — no toolchain, no archive checkout) and names the
# exact `git add <pkg>/` that greens it, failing fast before the expensive build. It shares the
# build gate's FLEET_BUILD_GUARD mode + FLEET_ALLOW_BUILD_BREAK escape. Fail-open: an older `fak`
# without the subcommand (exit 2) or a clean tip (exit 0) just falls through to the full build.
if [ "$build_mode" != "off" ] && [ "${FLEET_ALLOW_BUILD_BREAK:-0}" != "1" ]; then
	iw_status=0
	if command -v fak >/dev/null 2>&1; then
		iw_out="$(fak hooks import-witness --root "$root" 2>&1)"
		iw_status=$?
	elif command -v go >/dev/null 2>&1; then
		iw_out="$(cd "$root" && go run ./cmd/fak hooks import-witness --root "$root" 2>&1)"
		iw_status=$?
	else
		iw_status=2
	fi
	if [ "$iw_status" -eq 1 ]; then
		if [ "$build_mode" = "block" ]; then
			echo "IMPORT_OF_UNCOMMITTED_PACKAGE (blocked): a committed file imports a package with no tracked source." >&2
			echo "$iw_out" >&2
			echo "  fix: git add the missing package dir (named above), or revert the importer; then re-push." >&2
			echo "  override once: FLEET_ALLOW_BUILD_BREAK=1 git push   (intentional only)" >&2
			exit 1
		else
			echo "IMPORT_OF_UNCOMMITTED_PACKAGE (advisory): a committed file imports a package with no tracked source." >&2
			echo "$iw_out" >&2
			echo "  fix before others fetch, or hard-enforce with FLEET_BUILD_GUARD=block." >&2
		fi
	fi
	# iw_status 0 (clean) or 2 (could-not-run) => fall through to the full compile gate below.
fi

if [ "$build_mode" != "off" ] && [ "${FLEET_ALLOW_BUILD_BREAK:-0}" != "1" ]; then
	# In warn (advisory) mode the verdict never blocks, so a redundant concurrent full build is
	# pure contention: pass --advisory to single-flight it (one gate builds; peers skip with
	# SKIPPED_CONTENDED, exit 0 = allowed). Block mode omits the flag and always builds.
	build_adv=""
	[ "$build_mode" = "warn" ] && build_adv="--advisory"
	build_out=""
	build_status=0
	tips="$pushed_tips"
	[ -z "$tips" ] && tips="HEAD" # manual invocation compatibility
	for pushed_tip in $tips; do
		if command -v fak >/dev/null 2>&1; then
			one_out="$(fak hooks pre-push --root "$root" --tip "$pushed_tip" $build_adv 2>&1)"
			one_status=$?
		elif command -v go >/dev/null 2>&1; then
			one_out="$(cd "$root" && go run ./cmd/fak hooks pre-push --root "$root" --tip "$pushed_tip" $build_adv 2>&1)"
			one_status=$?
		else
			one_out="neither 'fak' nor 'go' is on PATH"
			one_status=2
		fi
		build_out="${build_out}${build_out:+\n}${one_out}"
		[ "$one_status" -eq 1 ] && build_status=1
		[ "$one_status" -ne 0 ] && [ "$build_status" -eq 0 ] && build_status=$one_status
	done

	if [ "$build_status" -eq 1 ]; then
		if [ "$build_mode" = "block" ]; then
			echo "TRUNK_WOULD_NOT_COMPILE (blocked): the pushed tip would not build for peers." >&2
			echo "$build_out" >&2
			echo "  fix: commit the missing definition (a caller ahead of its callee), or restore the removed symbol; then re-push." >&2
			echo "  override once: FLEET_ALLOW_BUILD_BREAK=1 git push   (intentional only)" >&2
			exit 1
		else
			echo "TRUNK_WOULD_NOT_COMPILE (advisory): the pushed tip would not build for peers." >&2
			echo "$build_out" >&2
			echo "  fix before others fetch, or hard-enforce with FLEET_BUILD_GUARD=block." >&2
		fi
	elif [ "$build_status" -ne 0 ]; then
		echo "TRUNK_WOULD_NOT_COMPILE (warn): build gate could not run; push allowed." >&2
		echo "$build_out" >&2
	fi
fi

# Desktop-popup gate  --  reason: DESKTOP_POPUP_REGRESSION
#
# A console-tool child (git/gh/powershell) spawned WITHOUT the Windows no-window hook flashes
# a visible console window every time background automation runs it — the operator's "so many
# popups". internal/windowgate already asserts a clean tracked tree (TestTrackedTreeHasNoPopups),
# but that test only runs in a full `go test ./...` the fleet build-guard path skips, so
# unsuppressed spawns kept reaching main. This rung runs the SAME scan at the push seam so the
# floor binds every agent and a human alike — the push-time complement to the compile gate above.
# Fix a hit by wrapping the Go exec with windowgate.ConfigureBackgroundCommand (or
# configureDispatchHelperCommand in cmd/fak), passing creationflags=no_window_creationflags() to
# the Python spawn, or making the .ps1 installer off-desktop.
#
# Mode (env FLEET_POPUP_GUARD):  block (default) | warn | off
# Escape:  FLEET_ALLOW_POPUP=1 git push   always allows.
# Fail-open by design: an older `fak` without the subcommand (exit 2) or an unavailable
# toolchain allows the push — a missing verifier must never wedge the trunk.
popup_mode="${FLEET_POPUP_GUARD:-block}"
if [ "$popup_mode" != "off" ] && [ "${FLEET_ALLOW_POPUP:-0}" != "1" ]; then
	popup_status=0
	if command -v fak >/dev/null 2>&1; then
		popup_out="$(fak hooks popup-scan --root "$root" 2>&1)"
		popup_status=$?
	elif command -v go >/dev/null 2>&1; then
		popup_out="$(cd "$root" && go run ./cmd/fak hooks popup-scan --root "$root" 2>&1)"
		popup_status=$?
	else
		popup_status=2
	fi
	if [ "$popup_status" -eq 1 ]; then
		if [ "$popup_mode" = "block" ]; then
			echo "DESKTOP_POPUP_REGRESSION (blocked): a tracked console-tool spawn would flash a window under background automation." >&2
			echo "$popup_out" >&2
			echo "  fix: suppress the spawn (windowgate.ConfigureBackgroundCommand / configureDispatchHelperCommand / creationflags=no_window_creationflags()); then re-push." >&2
			echo "  override once: FLEET_ALLOW_POPUP=1 git push   (intentional only)" >&2
			exit 1
		else
			echo "DESKTOP_POPUP_REGRESSION (advisory): a tracked console-tool spawn would flash a window under background automation." >&2
			echo "$popup_out" >&2
			echo "  fix before others fetch, or hard-enforce with FLEET_POPUP_GUARD=block." >&2
		fi
	fi
	# popup_status 0 (clean) or 2 (could-not-run) => fall through.
fi

[ "$mode" = "off" ] && exit 0
[ "${FLEET_ALLOW_RESIDUAL:-0}" = "1" ] && exit 0

# Need the dos CLI. Resolve it from PATH; if absent, fail open with a note.
dos_bin="$(command -v dos 2>/dev/null)"
if [ -z "$dos_bin" ]; then
	echo "CLAIM_UNWITNESSED (warn): 'dos' CLI not on PATH; claim-honesty review skipped." >&2
	exit 0
fi

# The range this push would ADD to the trunk: prefer this branch's own upstream,
# then origin/main, then the legacy origin/master. If none is known (fresh clone,
# detached remote), fall back to the last 20 commits rather than failing.
if git rev-parse --verify --quiet "origin/$branch" >/dev/null 2>&1; then
	range="origin/$branch..HEAD"
elif git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
	range="origin/main..HEAD"
elif git rev-parse --verify --quiet origin/master >/dev/null 2>&1; then
	range="origin/master..HEAD"
else
	range="HEAD~20..HEAD"
fi

# Nothing to review (push adds no commits) -> clean.
if [ -z "$(git rev-list "$range" 2>/dev/null)" ]; then
	exit 0
fi

out="$("$dos_bin" review --workspace "$root" "$range" 2>&1)"
status=$?

# exit 0 clean / 1 a RESIDUAL exists / 2 unreadable range (docs/358).
if [ "$status" -eq 0 ]; then
	exit 0
fi
if [ "$status" -eq 2 ]; then
	echo "CLAIM_UNWITNESSED (warn): dos review could not read $range; push allowed." >&2
	echo "$out" >&2
	exit 0
fi

# status == 1: a residual exists.
if [ "$mode" = "block" ]; then
	echo "CLAIM_UNWITNESSED (blocked): a commit in $range claims something its diff does not witness." >&2
	echo "$out" >&2
	echo "  fix: amend the subject to match what the diff does (a result-artifact drop is docs/chore, not test)," >&2
	echo "       or add the witnessing file; then re-push." >&2
	echo "  override once: FLEET_ALLOW_RESIDUAL=1 git push   (intentional false-positive only)" >&2
	exit 1
else
	echo "CLAIM_UNWITNESSED (advisory): a commit in $range claims something its diff does not witness." >&2
	echo "$out" >&2
	echo "  fix the subject to match the diff, or add the witnessing file. This hook blocks by default; current mode is FLEET_REVIEW_GUARD=warn." >&2
	exit 0
fi

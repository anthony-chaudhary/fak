{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fak sessions codex-loop-hook 2>/dev/null; status=$?; if [ \"$status\" -ne 0 ]; then printf '%s\\n' '{\"decision\":\"block\",\"reason\":\"codex_session_guard_unavailable: installed fak cannot run sessions codex-loop-hook. Rebuild or install a current fak, then relaunch with fak codex or fak guard -- codex.\"}'; exit 0; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Checking fak continuation guard"
          }
        ]
      }
    ]
  }
}

{
  "version": "fak-policy/v1",
  "posture": "fail_closed",
  "allow": [
    "Glob",
    "Grep",
    "LS",
    "Read"
  ],
  "allow_prefix": [
    "read_",
    "get_",
    "search_",
    "list_",
    "lookup_",
    "find_"
  ],
  "redact_fields": [
    "password",
    "secret",
    "api_key",
    "token",
    "authorization"
  ]
}

{
  "version": "fak-policy/v1",
  "allow": [
    "Bash",
    "BashOutput",
    "Edit",
    "Glob",
    "Grep",
    "KillShell",
    "LS",
    "NotebookEdit",
    "Read",
    "Task",
    "TodoWrite",
    "WebFetch",
    "WebSearch",
    "Write"
  ],
  "allow_prefix": [
    "read_",
    "get_",
    "search_",
    "list_",
    "lookup_",
    "find_"
  ],
  "self_modify_globs": [
    "internal/abi/",
    "internal/kernel/",
    "internal/adjudicator/",
    "internal/policy/",
    "internal/registrations/",
    ".git/",
    ".ssh/",
    ".dos/",
    "VERSION",
    "id_rsa",
    "/etc/"
  ],
  "redact_fields": [
    "password",
    "secret",
    "api_key",
    "token",
    "authorization"
  ],
  "arg_rules": [
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\\brm\\s+-[A-Za-z]*[rRfF]",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\\bsudo\\b",
      "reason": "POLICY_BLOCK",
      "fix": "hand the exact elevated command to the operator to run"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\\bmkfs\\b|\\bdd\\s+if=|\u003e\\s*/dev/sd",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": ":\\(\\)\\s*\\{",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\\b(curl|wget)\\b[^|]*\\|\\s*(sudo\\s+)?(ba)?sh\\b",
      "reason": "POLICY_BLOCK",
      "fix": "download to a file, read it, then run it as a separate reviewed step"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\\bterraform(?:\\.exe)?\\b[^|;\u0026\\n]*\\bdestroy\\b",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "-o\\s+\\.\\.[\\\\/]",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "--output[= ]\\s*\\.\\.[\\\\/]",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\u003e\u003e?\\s*\\.\\.[\\\\/]",
      "reason": "POLICY_BLOCK"
    },
    {
      "tool": "Bash",
      "arg": "command",
      "deny_regex": "\\b(cp|mv|install|tee|rsync|ln)\\b[^|;\u0026]*\\s\\.\\.[\\\\/]",
      "reason": "POLICY_BLOCK"
    }
  ],
  "lint_writes": true
}

#version 450
#extension GL_EXT_spirv_intrinsics : require

// v41_exact_rmsnorm.comp - per-row RMSNorm bit-identical to norm.SerialRMSNorm
// for a power-of-two width (Ref #13668). The V4.1 compressor and index-key
// norms publish into the KV cache and feed a discontinuous top-k, so the
// generic rmsnorm.comp (tree reduction, approximate reciprocal root) cannot bind
// them. Binary32 DenormPreserve, SignedZeroInfNanPreserve and RoundingModeRTE
// are explicit, as in v41_indexer_score.comp.
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4464], 4459, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Xbuf { float X[]; };
layout(std430, binding = 1) readonly  buffer Wbuf { float W[]; };
layout(std430, binding = 2) writeonly buffer Ybuf { float Y[]; };

// invWidth is the exact binary32 reciprocal of the power-of-two width, so
// ss*invWidth is the correctly rounded ss/width the host computes.
layout(push_constant) uniform Push { int rows; int width; float eps; float invWidth; } pc;

shared float sInv;

// Unsigned 64-bit integers as uvec2(lo, hi); shifts take 1 <= k <= 31.
uvec2 shl64(uvec2 a, uint k) { return uvec2(a.x << k, (a.y << k) | (a.x >> (32u - k))); }
uvec2 shr64(uvec2 a, uint k) { return uvec2((a.x >> k) | (a.y << (32u - k)), a.y >> k); }
bool ge64(uvec2 a, uvec2 b) { return a.y > b.y || (a.y == b.y && a.x >= b.x); }
uvec2 sub64(uvec2 a, uvec2 b) {
    uint borrow;
    uint lo = usubBorrow(a.x, b.x, borrow);
    return uvec2(lo, a.y - b.y - borrow);
}
uvec2 inc64(uvec2 a) {
    uint carry;
    uint lo = uaddCarry(a.x, 1u, carry);
    return uvec2(lo, a.y + carry);
}

// The host float32(1 / math.Sqrt(float64(y))) with every rounding of the host formula done
// exactly in integers: restoring square root of m*2^84 rounded to 53 bits,
// restoring division of 2^106 rounded to 53 bits, then RNE to 24 bits.
float invScale(float y) {
    uint b = floatBitsToUint(y);
    if (b >= 0x7f800000u) return 0.0;
    uint m = b & 0x7fffffu;
    int e = int(b >> 23) - 150;
    if ((b >> 23) == 0u) {
        if (m == 0u) return uintBitsToFloat(0x7f800000u);
        e = -149;
        while ((m & 0x800000u) == 0u) { m <<= 1; e -= 1; }
    } else {
        m |= 0x800000u;
    }
    if ((e & 1) != 0) { m <<= 1; e -= 1; }

    uvec2 root = uvec2(0u), rem = uvec2(0u);
    for (int i = 54; i >= 0; --i) {
        uint pair = i >= 42 ? (m >> uint(2 * (i - 42))) & 3u : 0u;
        rem = shl64(rem, 2u);
        rem.x |= pair;
        uvec2 trial = shl64(root, 2u);
        trial.x |= 1u;
        root = shl64(root, 1u);
        if (ge64(rem, trial)) { rem = sub64(rem, trial); root.x |= 1u; }
    }
    uint shift = root.y >= (1u << 22) ? 2u : 1u;
    uvec2 s = shr64(root, shift);
    uint low = root.x & ((1u << shift) - 1u), half_ = 1u << (shift - 1u);
    int es = e / 2 - 42 + int(shift);
    bool remNonZero = (rem.x | rem.y) != 0u;
    if (low > half_ || (low == half_ && (remNonZero || (s.x & 1u) == 1u))) s = inc64(s);
    if (s.y == (1u << 21) && s.x == 0u) { s = uvec2(0u, 1u << 20); es += 1; }

    uvec2 q = uvec2(0u), r = uvec2(0u);
    for (int i = 106; i >= 0; --i) {
        r = shl64(r, 1u);
        if (i == 106) r.x |= 1u;
        q = shl64(q, 1u);
        if (ge64(r, s)) { r = sub64(r, s); q.x |= 1u; }
    }
    uint lowq = q.x & 1u;
    uvec2 qq = shr64(q, 1u);
    int eq = -105 - es;
    if (lowq == 1u && ((r.x | r.y) != 0u || (qq.x & 1u) == 1u)) qq = inc64(qq);
    if (qq.y == (1u << 21) && qq.x == 0u) { qq = uvec2(0u, 1u << 20); eq += 1; }

    uint mant = shr64(qq, 29u).x;
    uint low29 = qq.x & 0x1fffffffu;
    int f = eq + 29;
    if (low29 > (1u << 28) || (low29 == (1u << 28) && (mant & 1u) == 1u)) mant += 1u;
    if (mant == (1u << 24)) { mant = 1u << 23; f += 1; }
    return uintBitsToFloat((uint(f + 150) << 23) | (mant & 0x7fffffu));
}

// One workgroup owns one row. Invocation 0 runs the in-order reduction and the
// scalar; every lane then scales its columns with two separately rounded products.
void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= uint(pc.rows)) return;
    uint base = row * uint(pc.width);
    if (gl_LocalInvocationID.x == 0u) {
        precise float ss = 0.0;
        for (uint i = 0u; i < uint(pc.width); ++i) {
            precise float v = X[base + i];
            precise float sq = v * v;
            precise float next = ss + sq;
            ss = next;
        }
        precise float mean = ss * pc.invWidth;
        precise float y = mean + pc.eps;
        sInv = invScale(y);
    }
    barrier();
    float inv = sInv;
    for (uint i = gl_LocalInvocationID.x; i < uint(pc.width); i += 64u) {
        precise float scaled = X[base + i] * inv;
        precise float out_ = scaled * W[i];
        Y[base + i] = out_;
    }
}

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
// rmsnorm_q8_matmul2_coop.comp — cooperative RMSNorm(X) -> two Q8_0 projections (FFN gate/up).
//
// Same bindings, push constants and arithmetic as rmsnorm_q8_matmul2.comp, but organized like
// swiglu_q8_matmul_add.comp: eight outputs share a 256-thread workgroup and the 32 lanes of an
// output each dot whole Q8_0 blocks, so a warp reads 32 consecutive 32-byte blocks of one weight
// row instead of 32 rows at a 1-row stride. The output owner (lane 0) accumulates the scaled
// block partials in the original block/window order, so every output is bit-identical to the
// one-thread-per-output kernel (float(dot) * Wscale * Xs, left to right, block-ordered).
//
// Dispatch is two-dimensional: ceil((out0+out1)/8) output groups on x, token rows on y.
layout(local_size_x = 256) in;

const uint BLOCK = 32u;
const uint SHARED_CAP = 2048u;
const uint WIN_BLOCKS = SHARED_CAP / BLOCK;
const uint PARTIAL_STRIDE = WIN_BLOCKS + 2u; // 66 floats (Pad-2)

layout(std430, binding = 0) readonly buffer W0q { int8_t W0codes[]; };
layout(std430, binding = 1) readonly buffer W0s { float W0scale[]; };
layout(std430, binding = 2) readonly buffer W1q { int8_t W1codes[]; };
layout(std430, binding = 3) readonly buffer W1s { float W1scale[]; };
layout(std430, binding = 4) readonly buffer Xb  { float X[]; };
layout(std430, binding = 5) readonly buffer Nb  { float NormW[]; };
layout(std430, binding = 6) writeonly buffer Y0b { float Y0[]; };
layout(std430, binding = 7) writeonly buffer Y1b { float Y1[]; };

layout(push_constant) uniform Push { int out0; int out1; int inDim; int P; float eps; } pc;

shared float  red[256];
shared int8_t Xq[SHARED_CAP];
shared float  Xs[WIN_BLOCKS];
shared float  partial[8u * PARTIAL_STRIDE];

int8_t q8round(float x) {
    int t = int(x);
    float f = x - float(t);
    if (f >= 0.5) t += 1; else if (f <= -0.5) t -= 1;
    t = clamp(t, -127, 127);
    return int8_t(t);
}

void main() {
    uint t = gl_WorkGroupID.y;
    if (t >= uint(pc.P)) return;
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid % BLOCK;
    uint row = tid / BLOCK;
    uint o = gl_WorkGroupID.x * 8u + row;
    uint out0 = uint(pc.out0);
    uint totalOut = out0 + uint(pc.out1);
    uint in_ = uint(pc.inDim);
    uint nblk = in_ / BLOCK;
    uint xbase = t * in_;

    // ---- pass 1: RMS reduction over the whole row -> inv scale (same order as the scalar kernel) ----
    float local = 0.0;
    for (uint i = tid; i < in_; i += 256u) {
        float v = X[xbase + i];
        local += v * v;
    }
    red[tid] = local;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float inv = inversesqrt(red[0] / float(pc.inDim) + pc.eps);
    barrier();

    bool valid = o < totalOut;
    bool isW0 = o < out0;
    uint oLocal = isW0 ? o : (o - out0);
    uint wbaseCodes = oLocal * in_;
    uint sbase = oLocal * nblk;
    float acc = 0.0;

    for (uint wb = 0u; wb < nblk; wb += WIN_BLOCKS) {
        uint winBlocks = min(WIN_BLOCKS, nblk - wb);
        uint winBase = wb * BLOCK;
        for (uint b = tid; b < winBlocks; b += 256u) {
            uint base = b * BLOCK;
            uint gbase = winBase + base;
            float amax = 0.0;
            for (uint i = 0u; i < BLOCK; ++i) {
                float xn = X[xbase + gbase + i] * inv * NormW[gbase + i];
                amax = max(amax, abs(xn));
            }
            float d = amax / 127.0;
            Xs[b] = d;
            float qd = d > 0.0 ? 1.0 / d : 0.0;
            for (uint i = 0u; i < BLOCK; ++i) {
                float xn = X[xbase + gbase + i] * inv * NormW[gbase + i];
                Xq[base + i] = (d > 0.0) ? q8round(xn * qd) : int8_t(0);
            }
        }
        barrier();

        if (valid) {
            for (uint lb = lane; lb < winBlocks; lb += BLOCK) {
                uint cb = wbaseCodes + (wb + lb) * BLOCK;
                uint xb = lb * BLOCK;
                int s0 = 0, s1 = 0, s2 = 0, s3 = 0;
                float sc;
                if (isW0) {
                    for (uint i = 0u; i < BLOCK; i += 4u) {
                        s0 += int(W0codes[cb + i])      * int(Xq[xb + i]);
                        s1 += int(W0codes[cb + i + 1u]) * int(Xq[xb + i + 1u]);
                        s2 += int(W0codes[cb + i + 2u]) * int(Xq[xb + i + 2u]);
                        s3 += int(W0codes[cb + i + 3u]) * int(Xq[xb + i + 3u]);
                    }
                    sc = W0scale[sbase + wb + lb];
                } else {
                    for (uint i = 0u; i < BLOCK; i += 4u) {
                        s0 += int(W1codes[cb + i])      * int(Xq[xb + i]);
                        s1 += int(W1codes[cb + i + 1u]) * int(Xq[xb + i + 1u]);
                        s2 += int(W1codes[cb + i + 2u]) * int(Xq[xb + i + 2u]);
                        s3 += int(W1codes[cb + i + 3u]) * int(Xq[xb + i + 3u]);
                    }
                    sc = W1scale[sbase + wb + lb];
                }
                partial[row * PARTIAL_STRIDE + lb] = float((s0 + s1) + (s2 + s3)) * sc;
            }
        }
        barrier();
        if (lane == 0u && valid) {
            for (uint lb = 0u; lb < winBlocks; ++lb) acc += partial[row * PARTIAL_STRIDE + lb] * Xs[lb];
        }
        barrier();
    }

    if (lane == 0u && valid) {
        if (isW0) Y0[t * out0 + o] = acc;
        else      Y1[t * uint(pc.out1) + oLocal] = acc;
    }
}

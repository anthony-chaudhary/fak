#version 450

// Experimental same-expert token tile. Adapted from fak's q2k_matvec mode 0
// and v41_q2k_matvec_id Q2K_BANK arithmetic. Prior art: llama.cpp multi-column
// GEMV, MIT, ggml authors, pinned ccdbe290533f68154ede46e0618622eebcb6c070:
// ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec.comp and mul_mat_vec_base.glsl.
// The token loop is INSIDE each quant decode: all tokens reuse that register
// value. Every token retains its own sums and the same 64-lane reduction tree.
// No activation/BF16/status policy is changed by this contraction primitive.
layout(local_size_x = 64) in;

const uint OUT_ROWS = 2u;
const uint LANES = 64u;
const uint MAX_TOKENS = 8u;
layout(std430, set = 0, binding = 0) readonly buffer W { uint raw[]; };
layout(std430, set = 0, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { int outDim; int inDim; int tokens; } pc;

shared float red[MAX_TOKENS * OUT_ROWS * LANES];

vec4 bytesOf(uint w) {
    return vec4(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u), float(w >> 24u));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint rowBase = gl_WorkGroupID.x * OUT_ROWS;
    uint outDim = uint(pc.outDim), inDim = uint(pc.inDim);
    uint tokens = uint(pc.tokens), nsb = inDim / 256u;
    uint wordsPerRow = nsb * 21u;
    uint t16 = tid & 15u, h = t16 >> 3u, s = (t16 >> 2u) & 1u;
    uint lq = (t16 & 3u) * 4u;
    float acc[MAX_TOKENS * OUT_ROWS];
    for (uint t = 0u; t < tokens; ++t) {
        for (uint r = 0u; r < OUT_ROWS; ++r) acc[t * OUT_ROWS + r] = 0.0;
    }
    for (uint sb = tid >> 4u; sb < nsb; sb += LANES / 16u) {
        for (uint r = 0u; r < OUT_ROWS; ++r) {
            uint row = rowBase + r;
            if (row >= outDim) break;
            uint base = row * wordsPerRow + sb * 21u;
            uint q = raw[base + 4u + t16];
            uint sc0 = raw[base + h * 2u];
            uint sc1 = raw[base + h * 2u + 1u];
            vec2 dd = unpackHalf2x16(raw[base + 20u]);
            uint scj[4];
            scj[0] = (sc0 >> (s * 8u)) & 255u;
            scj[1] = (sc0 >> ((2u + s) * 8u)) & 255u;
            scj[2] = (sc1 >> (s * 8u)) & 255u;
            scj[3] = (sc1 >> ((2u + s) * 8u)) & 255u;
            float sum[MAX_TOKENS];
            for (uint t = 0u; t < tokens; ++t) sum[t] = 0.0;
            for (uint j = 0u; j < 4u; ++j) {
                vec4 qv = bytesOf((q >> (2u * j)) & 0x03030303u);
                float dl = dd.x * float(scj[j] & 15u);
                float ml = dd.y * float(scj[j] >> 4u);
                uint idx = (sb * 256u + h * 128u + j * 32u + s * 16u + lq) >> 2u;
                for (uint t = 0u; t < tokens; ++t) {
                    vec4 xv = x4[t * (inDim >> 2u) + idx];
                    float xsum = xv.x + xv.y + xv.z + xv.w;
                    sum[t] += dl * dot(qv, xv) - ml * xsum;
                }
            }
            for (uint t = 0u; t < tokens; ++t) acc[t * OUT_ROWS + r] += sum[t];
        }
    }
    for (uint t = 0u; t < tokens; ++t) {
        for (uint r = 0u; r < OUT_ROWS; ++r) red[(t * OUT_ROWS + r) * LANES + tid] = acc[t * OUT_ROWS + r];
    }
    barrier();
    for (uint stride = LANES / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            for (uint t = 0u; t < tokens; ++t) {
                for (uint r = 0u; r < OUT_ROWS; ++r) {
                    uint off = (t * OUT_ROWS + r) * LANES + tid;
                    red[off] += red[off + stride];
                }
            }
        }
        barrier();
    }
    if (tid < OUT_ROWS && rowBase + tid < outDim) {
        for (uint t = 0u; t < tokens; ++t) y[t * outDim + rowBase + tid] = red[(t * OUT_ROWS + tid) * LANES];
    }
}

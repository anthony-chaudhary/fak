#version 450
layout(local_size_x = 64) in;

// DeepSeek V4.1 mHC stream operations over row panels. Every mode reads and
// writes binary32 storage; residual publications are rounded to BF16 with the
// same integer round-to-nearest-even as the host (model.v41RoundBF16).
//
// mode 0 initial: A=x[rows,H]                      -> Out[rows,4,H]
// mode 1 split:   A=mixes[rows,24] B=scale[3] C=base[24] -> Out=coeffs[rows,24]
// mode 2 pre:     A=streams[rows,4,H] B=coeffs[rows,24]  -> Out[rows,H]
// mode 3 post:    A=x[rows,H] B=streams[rows,4,H] C=coeffs[rows,24] -> Out[rows,4,H]
// mode 4 rms-split: A=raw mixes[rows,24] B=streams[rows,4,H] C=scale[3]|base[24]
//                   -> Out=coeffs[rows,24]; mixes are first scaled by the flattened
//                   streams' 1/sqrt(mean(x^2)+rmsEps), summed serially as the host does;
//                   dispatched as one workgroup per row.
// mode 5 prenorm-f32: A=mix weight F32[24,4H] B=streams[rows,4,H]
//                   -> Out=prenorm[rows,25] = raw mixes[24] | serial sum of squares
// mode 6 prenorm-q2k: as mode 5 with A the raw Q2_K bytes of the [24,4H] weight
// mode 7 prenorm-split: A=prenorm[rows,25] C=scale[3]|base[24] -> Out=coeffs[rows,24]
//                   Modes 5/6 then 7 are mode 4 preceded by the one-token projection:
//                   every raw mix is matmul.comp's decode chunk sum (F32) or
//                   q2k_matvec.comp's lane sum and tree (Q2_K) term for term, the
//                   squares are summed in index order as rmsSplit does, and mode 7
//                   is rmsSplit's scale and split. Modes 5/6 dispatch rows*(G+1)
//                   workgroups: G projection groups beside one sum-of-squares group.
// coeffs rows are pre[4] | post[4] | comb[16] (comb row-major [src,dst]).
layout(std430, binding = 0) readonly buffer ABuf { float A[]; };
layout(std430, binding = 0) readonly buffer AWords { uint Aw[]; };
layout(std430, binding = 1) readonly buffer BBuf { float B[]; };
layout(std430, binding = 1) readonly buffer BVec4 { vec4 B4[]; };
layout(std430, binding = 2) readonly buffer CBuf { float C[]; };
layout(std430, binding = 3) writeonly buffer OutBuf { float Out[]; };

layout(push_constant) uniform Push {
    int mode;
    int rows;
    int hidden;
    int iters;
    float eps;
    float rmsEps;
} pc;

float bf16(float v) {
    uint bits = floatBitsToUint(v);
    bits += 0x7fffu + ((bits >> 16) & 1u);
    return uintBitsToFloat(bits & 0xffff0000u);
}

// Correctly rounded binary32 quotient for finite, normal operands: one Newton
// step on the reciprocal, then one residual correction (Markstein).
float divRN(float a, float b) {
    precise float y = 1.0 / b;
    precise float e = fma(-b, y, 1.0);
    precise float y1 = fma(e, y, y);
    precise float q = a * y1;
    precise float r = fma(-b, q, a);
    precise float out1 = fma(r, y1, q);
    return out1;
}

// Cody-Waite reduction and the Cephes expf polynomial (about 1 ulp), so the
// result tracks the host's float32(math.Exp(float64(x))) without the
// range-dependent error of exp2(x*log2e).
float expF32(float x) {
    if (x > 88.72283935546875) return uintBitsToFloat(0x7f800000u);
    if (x < -103.97207641601562) return 0.0;
    precise float n = roundEven(x * 1.4426950408889634);
    precise float r0 = fma(n, -0.693359375, x);
    precise float r = fma(n, 2.12194440e-4, r0);
    precise float p = 1.9875691500e-4;
    p = fma(p, r, 1.3981999507e-3);
    p = fma(p, r, 8.3334519073e-3);
    p = fma(p, r, 4.1665795894e-2);
    p = fma(p, r, 1.6666665459e-1);
    p = fma(p, r, 5.0000001201e-1);
    precise float rr = r * r;
    precise float poly = fma(p, rr, r);
    precise float e = poly + 1.0;
    int k = int(n);
    // Split the scale so 2^k never overflows before the product rounds.
    if (k > 127) {
        e = e * 2.0;
        k -= 1;
    }
    if (k < -126) {
        precise float tiny = e * uintBitsToFloat(0x00800000u);
        return tiny * exp2(float(k + 126));
    }
    return e * uintBitsToFloat(uint(k + 127) << 23);
}

float sigmoidF32(float x) {
    precise float e = expF32(-x);
    precise float d = 1.0 + e;
    if (isinf(d)) return 0.0;
    return divRN(1.0, d);
}

void initialStreams(uint i) {
    uint H = uint(pc.hidden);
    uint total = uint(pc.rows) * H;
    if (i >= total) return;
    uint row = i / H;
    uint d = i - row * H;
    float v = bf16(A[i]);
    uint base = row * 4u * H + d;
    for (uint h = 0u; h < 4u; ++h) Out[base + h * H] = v;
}

void splitCore(uint m, float mix[24], float sc[3], float bs[24]) {
    float eps = pc.eps;
    float c[16];
    for (uint j = 0u; j < 4u; ++j) {
        precise float a = mix[j] * sc[0];
        precise float preArg = a + bs[j];
        precise float pre = sigmoidF32(preArg) + eps;
        Out[m + j] = pre;
        precise float b = mix[4u + j] * sc[1];
        precise float postArg = b + bs[4u + j];
        precise float post = 2.0 * sigmoidF32(postArg);
        Out[m + 4u + j] = post;
    }
    for (uint i = 0u; i < 16u; ++i) {
        precise float x = mix[8u + i] * sc[2];
        precise float y = x + bs[8u + i];
        c[i] = y;
    }
    for (uint r = 0u; r < 4u; ++r) {
        float mx = c[r * 4u];
        for (uint k = 1u; k < 4u; ++k) mx = max(mx, c[r * 4u + k]);
        precise float sum = 0.0;
        for (uint k = 0u; k < 4u; ++k) {
            precise float shifted = c[r * 4u + k] - mx;
            c[r * 4u + k] = expF32(shifted);
            sum = sum + c[r * 4u + k];
        }
        for (uint k = 0u; k < 4u; ++k) {
            precise float q = divRN(c[r * 4u + k], sum);
            precise float v = q + eps;
            c[r * 4u + k] = v;
        }
    }
    for (int it = 0; it < pc.iters; ++it) {
        if (it > 0) {
            for (uint r = 0u; r < 4u; ++r) {
                precise float sum = 0.0;
                for (uint k = 0u; k < 4u; ++k) sum = sum + c[r * 4u + k];
                precise float den = sum + eps;
                for (uint k = 0u; k < 4u; ++k) c[r * 4u + k] = divRN(c[r * 4u + k], den);
            }
        }
        for (uint k = 0u; k < 4u; ++k) {
            precise float sum = 0.0;
            for (uint r = 0u; r < 4u; ++r) sum = sum + c[r * 4u + k];
            precise float den = sum + eps;
            for (uint r = 0u; r < 4u; ++r) c[r * 4u + k] = divRN(c[r * 4u + k], den);
        }
    }
    for (uint i = 0u; i < 16u; ++i) Out[m + 8u + i] = c[i];
}

void split(uint row) {
    if (row >= uint(pc.rows)) return;
    uint m = row * 24u;
    float mix[24];
    float sc[3];
    float bs[24];
    for (uint i = 0u; i < 24u; ++i) {
        mix[i] = A[m + i];
        bs[i] = C[i];
    }
    for (uint i = 0u; i < 3u; ++i) sc[i] = B[i];
    splitCore(m, mix, sc, bs);
}

// 1/sqrt(x) within about one ulp of the correctly rounded value: hardware
// estimate refined by one Newton step with fused residuals.
float rsqrtF32(float x) {
    precise float y = inversesqrt(x);
    precise float yy = y * y;
    precise float e = fma(-x, yy, 1.0);
    precise float h = 0.5 * y;
    precise float r = fma(h, e, y);
    return r;
}

// One workgroup per row. The 64 lanes stage the squares of a chunk into shared
// memory with coalesced loads; lane 0 then adds them in index order, so the sum
// stays the host's serial F32 ss += v*v bit for bit.
const uint RMS_CHUNK = 2048u;
shared vec4 Sq[RMS_CHUNK / 4u];

void rmsSplit(uint row, uint lid) {
    uint m = row * 24u;
    uint width = 4u * uint(pc.hidden);
    uint s = row * width;
    precise float ss = 0.0;
    for (uint base = 0u; base < width; base += RMS_CHUNK) {
        uint n = min(RMS_CHUNK, width - base);
        for (uint j = lid; j < n; j += 64u) {
            uint k = base + j;
            precise float sq = B[s + k] * B[s + k];
            Sq[j >> 2u][j & 3u] = sq;
        }
        barrier();
        if (lid == 0u) {
            uint j = 0u;
            for (; j + 16u <= n; j += 16u) {
                vec4 a = Sq[j >> 2u], b = Sq[(j >> 2u) + 1u], c = Sq[(j >> 2u) + 2u], e = Sq[(j >> 2u) + 3u];
                ss = ss + a.x; ss = ss + a.y; ss = ss + a.z; ss = ss + a.w;
                ss = ss + b.x; ss = ss + b.y; ss = ss + b.z; ss = ss + b.w;
                ss = ss + c.x; ss = ss + c.y; ss = ss + c.z; ss = ss + c.w;
                ss = ss + e.x; ss = ss + e.y; ss = ss + e.z; ss = ss + e.w;
            }
            for (; j < n; ++j) ss = ss + Sq[j >> 2u][j & 3u];
        }
        barrier();
    }
    if (lid != 0u) return;
    precise float mean = divRN(ss, float(width));
    precise float arg = mean + pc.rmsEps;
    float r = rsqrtF32(arg);
    float mix[24];
    float sc[3];
    float bs[24];
    for (uint i = 0u; i < 24u; ++i) {
        precise float v = A[m + i] * r;
        mix[i] = v;
        bs[i] = C[3u + i];
    }
    for (uint i = 0u; i < 3u; ++i) sc[i] = C[i];
    splitCore(m, mix, sc, bs);
}

void preCollapse(uint i) {
    uint H = uint(pc.hidden);
    uint total = uint(pc.rows) * H;
    if (i >= total) return;
    uint row = i / H;
    uint d = i - row * H;
    uint s = row * 4u * H + d;
    uint m = row * 24u;
    precise float acc = 0.0;
    for (uint h = 0u; h < 4u; ++h) {
        precise float p = B[m + h] * A[s + h * H];
        acc = acc + p;
    }
    Out[i] = bf16(acc);
}

void postMix(uint i) {
    uint H = uint(pc.hidden);
    uint total = uint(pc.rows) * 4u * H;
    if (i >= total) return;
    uint row = i / (4u * H);
    uint rem = i - row * 4u * H;
    uint dst = rem / H;
    uint d = rem - dst * H;
    uint s = row * 4u * H + d;
    uint m = row * 24u;
    precise float acc = 0.0;
    for (uint src = 0u; src < 4u; ++src) {
        precise float p = C[m + 8u + src * 4u + dst] * B[s + src * H];
        acc = acc + p;
    }
    precise float x = C[m + 4u + dst] * bf16(A[row * H + d]);
    acc = acc + x;
    Out[i] = bf16(acc);
}

// Adapted from the split structure of DeepGEMM sm100_tf32_hc_prenorm_gemm and
// TileKernels mhc_reduce_partials_and_rmsnorm_fwd (MIT; THIRD_PARTY_NOTICES.md),
// keeping fak's F32/Q2_K projection order instead of their TF32 MMA.
const uint PRENORM_STRIDE = 25u;
const uint SS_CHUNK = 1024u;
// Not Sq: glslang marks every write to an array that a precise sum reads as
// NoContraction, which would forbid the FMA contraction matmul.comp may get.
shared float PrenormPart[64];

uint prenormChunks(uint width) { return (width + 1023u) / 1024u; }

uint prenormDotGroups(uint width) {
    if (pc.mode == 6) return 12u;
    uint perGroup = 64u / prenormChunks(width);
    return (24u + perGroup - 1u) / perGroup;
}

// The loads of the next chunk are issued before lane 0 adds the current one;
// the sum itself is rmsSplit's: squares rounded once, then added in index order.
float prenormSumSquares(uint s, uint width, uint lid) {
    precise float ss = 0.0;
    uint n0 = min(SS_CHUNK, width);
    for (uint j = lid; j < n0; j += 64u) {
        precise float sq = B[s + j] * B[s + j];
        Sq[j >> 2u][j & 3u] = sq;
    }
    barrier();
    uint buf = 0u;
    for (uint base = 0u; base < width; base += SS_CHUNK) {
        uint n = min(SS_CHUNK, width - base);
        uint next = base + SS_CHUNK;
        uint nn = next < width ? min(SS_CHUNK, width - next) : 0u;
        float v[16];
        for (uint t = 0u; t < 16u; ++t) {
            uint j = lid + 64u * t;
            v[t] = j < nn ? B[s + next + j] : 0.0;
        }
        if (lid == 0u) {
            uint o = buf * SS_CHUNK;
            uint j = 0u;
            for (; j + 16u <= n; j += 16u) {
                uint q = (o + j) >> 2u;
                vec4 a = Sq[q], b = Sq[q + 1u], c = Sq[q + 2u], e = Sq[q + 3u];
                ss = ss + a.x; ss = ss + a.y; ss = ss + a.z; ss = ss + a.w;
                ss = ss + b.x; ss = ss + b.y; ss = ss + b.z; ss = ss + b.w;
                ss = ss + c.x; ss = ss + c.y; ss = ss + c.z; ss = ss + c.w;
                ss = ss + e.x; ss = ss + e.y; ss = ss + e.z; ss = ss + e.w;
            }
            for (; j < n; ++j) ss = ss + Sq[(o + j) >> 2u][(o + j) & 3u];
        }
        uint ob = (buf ^ 1u) * SS_CHUNK;
        for (uint t = 0u; t < 16u; ++t) {
            uint j = lid + 64u * t;
            if (j < nn) {
                precise float sq = v[t] * v[t];
                Sq[(ob + j) >> 2u][(ob + j) & 3u] = sq;
            }
        }
        buf ^= 1u;
        barrier();
    }
    return ss;
}

// matmul.comp decodeChunks with 64 lanes: each lane runs one 1024-wide chunk's
// serial partial with the same loads and accumulation, and the chunk-0 lane
// adds the partials in chunk order onto 0.0.
void prenormDotsF32(uint row, uint d, uint tid) {
    uint in_ = 4u * uint(pc.hidden);
    uint chunks = prenormChunks(in_);
    uint perGroup = 64u / chunks;
    uint local = tid / chunks;
    uint c = tid - local * chunks;
    uint o = d * perGroup + local;
    bool live = local < perGroup && o < 24u;
    uint xrow = row * in_;
    if (live) {
        uint c0 = c * 1024u;
        uint clen = min(1024u, in_ - c0);
        uint wbase = o * in_ + c0;
        uint xbase = xrow + c0;
        float acc = 0.0;
        uint i = 0u;
        for (; i + 16u <= clen; i += 16u) {
            float w0 = A[wbase + i + 0u], w1 = A[wbase + i + 1u], w2 = A[wbase + i + 2u], w3 = A[wbase + i + 3u];
            float w4 = A[wbase + i + 4u], w5 = A[wbase + i + 5u], w6 = A[wbase + i + 6u], w7 = A[wbase + i + 7u];
            float w8 = A[wbase + i + 8u], w9 = A[wbase + i + 9u], w10 = A[wbase + i + 10u], w11 = A[wbase + i + 11u];
            float w12 = A[wbase + i + 12u], w13 = A[wbase + i + 13u], w14 = A[wbase + i + 14u], w15 = A[wbase + i + 15u];
            float x0 = B[xbase + i + 0u], x1 = B[xbase + i + 1u], x2 = B[xbase + i + 2u], x3 = B[xbase + i + 3u];
            float x4 = B[xbase + i + 4u], x5 = B[xbase + i + 5u], x6 = B[xbase + i + 6u], x7 = B[xbase + i + 7u];
            float x8 = B[xbase + i + 8u], x9 = B[xbase + i + 9u], x10 = B[xbase + i + 10u], x11 = B[xbase + i + 11u];
            float x12 = B[xbase + i + 12u], x13 = B[xbase + i + 13u], x14 = B[xbase + i + 14u], x15 = B[xbase + i + 15u];
            acc += w0 * x0;
            acc += w1 * x1;
            acc += w2 * x2;
            acc += w3 * x3;
            acc += w4 * x4;
            acc += w5 * x5;
            acc += w6 * x6;
            acc += w7 * x7;
            acc += w8 * x8;
            acc += w9 * x9;
            acc += w10 * x10;
            acc += w11 * x11;
            acc += w12 * x12;
            acc += w13 * x13;
            acc += w14 * x14;
            acc += w15 * x15;
        }
        for (; i < clen; ++i) acc += A[wbase + i] * B[xbase + i];
        PrenormPart[tid] = acc;
    }
    barrier();
    if (live && c == 0u) {
        float y = 0.0;
        for (uint k = 0u; k < chunks; ++k) y += PrenormPart[tid + k];
        Out[row * PRENORM_STRIDE + o] = y;
    }
}

vec4 q2kBytesOf(uint w) {
    return vec4(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u), float(w >> 24u));
}

// q2k_matvec.comp mode 0 for the two rows 2d and 2d+1: the same lane split,
// per-superblock terms, lane accumulation and LDS tree.
void prenormDotsQ2K(uint row, uint d, uint tid) {
    uint inDim = 4u * uint(pc.hidden);
    uint nsb = inDim / 256u;
    uint wordsPerRow = nsb * 21u;
    uint rowBase = d * 2u;
    uint xrow4 = row * (inDim >> 2u);
    uint t16 = tid & 15u;
    uint h = t16 >> 3u;
    uint s = (t16 >> 2u) & 1u;
    uint lq = (t16 & 3u) * 4u;

    precise float acc[2];
    for (uint r = 0u; r < 2u; ++r) acc[r] = 0.0;

    for (uint sb = tid >> 4u; sb < nsb; sb += 4u) {
        vec4 xv[4];
        precise float xsum[4];
        for (uint j = 0u; j < 4u; ++j) {
            uint idx = (sb * 256u + h * 128u + j * 32u + s * 16u + lq) >> 2u;
            vec4 v = B4[xrow4 + idx];
            xv[j] = v;
            precise float x01 = v.x + v.y;
            precise float x012 = x01 + v.z;
            precise float x0123 = x012 + v.w;
            xsum[j] = x0123;
        }
        for (uint r = 0u; r < 2u; ++r) {
            uint orow = rowBase + r;
            if (orow >= 24u) break;
            uint base = orow * wordsPerRow + sb * 21u;
            uint q = Aw[base + 4u + t16];
            uint sc0 = Aw[base + h * 2u];
            uint sc1 = Aw[base + h * 2u + 1u];
            uint dm = Aw[base + 20u];
            vec2 dd = unpackHalf2x16(dm);
            uint scj[4];
            scj[0] = (sc0 >> (s * 8u)) & 255u;
            scj[1] = (sc0 >> ((2u + s) * 8u)) & 255u;
            scj[2] = (sc1 >> (s * 8u)) & 255u;
            scj[3] = (sc1 >> ((2u + s) * 8u)) & 255u;
            precise float sum = 0.0;
            for (uint j = 0u; j < 4u; ++j) {
                vec4 qv = q2kBytesOf((q >> (2u * j)) & 0x03030303u);
                precise float dl = dd.x * float(scj[j] & 15u);
                precise float ml = dd.y * float(scj[j] >> 4u);
                precise float q0 = qv.x * xv[j].x;
                precise float q1 = qv.y * xv[j].y;
                precise float q2 = qv.z * xv[j].z;
                precise float q3 = qv.w * xv[j].w;
                precise float q01 = q0 + q1;
                precise float q012 = q01 + q2;
                precise float qdot = q012 + q3;
                precise float scaledDot = dl * qdot;
                precise float minTerm = ml * xsum[j];
                precise float term = scaledDot - minTerm;
                sum = sum + term;
            }
            precise float nextAcc = acc[r] + sum;
            acc[r] = nextAcc;
        }
    }

    for (uint r = 0u; r < 2u; ++r) {
        uint k = r * 64u + tid;
        Sq[k >> 2u][k & 3u] = acc[r];
    }
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            for (uint r = 0u; r < 2u; ++r) {
                uint off = r * 64u + tid;
                uint hi = off + stride;
                precise float reduced = Sq[off >> 2u][off & 3u] + Sq[hi >> 2u][hi & 3u];
                Sq[off >> 2u][off & 3u] = reduced;
            }
        }
        barrier();
    }
    if (tid < 2u) {
        uint orow = rowBase + tid;
        uint k = tid * 64u;
        if (orow < 24u) Out[row * PRENORM_STRIDE + orow] = Sq[k >> 2u][k & 3u];
    }
}

void prenorm(uint g, uint lid) {
    uint width = 4u * uint(pc.hidden);
    uint per = prenormDotGroups(width) + 1u;
    uint row = g / per;
    if (row >= uint(pc.rows)) return;
    uint sub = g - row * per;
    if (sub == 0u) {
        float ss = prenormSumSquares(row * width, width, lid);
        if (lid == 0u) Out[row * PRENORM_STRIDE + 24u] = ss;
    } else if (pc.mode == 5) {
        prenormDotsF32(row, sub - 1u, lid);
    } else {
        prenormDotsQ2K(row, sub - 1u, lid);
    }
}

void prenormSplit(uint row) {
    if (row >= uint(pc.rows)) return;
    uint width = 4u * uint(pc.hidden);
    uint a = row * PRENORM_STRIDE;
    precise float mean = divRN(A[a + 24u], float(width));
    precise float arg = mean + pc.rmsEps;
    float r = rsqrtF32(arg);
    float mix[24];
    float sc[3];
    float bs[24];
    for (uint i = 0u; i < 24u; ++i) {
        precise float v = A[a + i] * r;
        mix[i] = v;
        bs[i] = C[3u + i];
    }
    for (uint i = 0u; i < 3u; ++i) sc[i] = C[i];
    splitCore(row * 24u, mix, sc, bs);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (pc.mode == 0) initialStreams(i);
    else if (pc.mode == 1) split(i);
    else if (pc.mode == 2) preCollapse(i);
    else if (pc.mode == 3) postMix(i);
    else if (pc.mode == 4 && gl_WorkGroupID.x < uint(pc.rows)) rmsSplit(gl_WorkGroupID.x, gl_LocalInvocationID.x);
    else if (pc.mode == 5 || pc.mode == 6) prenorm(gl_WorkGroupID.x, gl_LocalInvocationID.x);
    else if (pc.mode == 7) prenormSplit(i);
}

#version 450

// coopmat_wave32_wmma.comp — Wave32 16x16x16 (FP16/BF16) and 16x16x32 (INT8/FP8) WMMA cooperative matrix compute shader.
//
// MIT License
// Ported and adapted from Nathanw1014/strix-halo-llamacpp@45bec945
// Copyright (c) 2025 Nathanw1014
// Copyright (c) 2026 anthony-chaudhary/fak contributors
//
// Attribution & Micro-Architectural Explanation:
// AMD RDNA 3.5 (gfx1151 / AMD Strix Halo / Ryzen AI MAX+ 395 APU) features native Wave32
// SIMD execution with hardware Wave Matrix Multiply-Accumulate (WMMA) instructions:
//   - 16x16x16 tile primitive for FP16 and BF16.
//   - 16x16x32 tile primitive for INT8, FP8, and INT4 (dual-issue throughput).
//
// Key Optimizations:
// 1. Workgroup Geometry & Wave Retiling:
//    Workgroup dimensions are set to local_size_x = 32, local_size_y = 4, local_size_z = 1.
//    With subgroup_size = 32, each workgroup comprises exactly 4 Wave32 wavefronts (128 threads total).
//    The 4 waves are organized in a 2x2 wave grid:
//      - Wave (0,0): output tile [0..15, 0..15]
//      - Wave (0,1): output tile [0..15, 16..31]
//      - Wave (1,0): output tile [16..31, 0..15]
//      - Wave (1,1): output tile [16..31, 16..31]
//    This maps to a 32x32 spatial output tile per workgroup, exactly matching the tuning in
//    rocm_arch.go TuneCooperativeMatrixGEMM.
//
// 2. LDS Shared Memory Bank Conflict Elimination (Pad-2 Stride):
//    On AMD RDNA hardware, Local Data Share (LDS) is divided into 32 memory banks of 4 bytes each.
//    Standard row strides of 32 or 16 floats cause threads within a Wave32 wavefront to map to
//    identical LDS bank indices (bank = (threadId * stride) % 32), resulting in heavy bank conflict
//    serialization stalls (collapsing bank coverage down to 2 or 8 banks).
//    By padding the row stride by +2 elements (stride = 32 + 2 = 34 floats/elements),
//    gcd(34, 32) = 2, distributing memory accesses across 16 banks and eliminating bank conflict
//    stalls, unlocking a measured +13% GEMM throughput speedup.

#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable

// Workgroup configuration: 4 Wave32 wavefronts (128 threads)
layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

// Push constants for matrix dimensions and scalar multipliers
layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
    float alpha;
    float beta;
    uint lda;
    uint ldb;
    uint ldc;
} pc;

// Precision selection:
// Defining WMMA_INT8 configures 16x16x32 INT8/FP8 WMMA dual-issue mode.
// By default, 16x16x16 FP16/BF16 WMMA is selected.
#ifdef WMMA_INT8
const uint TILE_K = 32u;
#define ELEM_TYPE_A int8_t
#define ELEM_TYPE_B int8_t
#define ELEM_TYPE_C int32_t
#else
const uint TILE_K = 16u;
#define ELEM_TYPE_A float16_t
#define ELEM_TYPE_B float16_t
#define ELEM_TYPE_C float
#endif

// Tile dimensions matching TuneCooperativeMatrixGEMM
const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint LDS_PAD_2 = 2u;
const uint STRIDE_N = TILE_N + LDS_PAD_2; // 32 + 2 = 34 elements (Pad-2 LDS stride)
const uint STRIDE_K = TILE_K + LDS_PAD_2; // TILE_K + 2 elements (Pad-2 LDS stride)

// Shared memory tile buffers with Pad-2 alignment to eliminate LDS bank conflicts
shared ELEM_TYPE_A ldsTileA[TILE_M * STRIDE_K];
shared ELEM_TYPE_B ldsTileB[TILE_K * STRIDE_N];

// Input and output storage buffers
layout(std430, set = 0, binding = 0) readonly buffer BufferA {
    ELEM_TYPE_A dataA[];
};

layout(std430, set = 0, binding = 1) readonly buffer BufferB {
    ELEM_TYPE_B dataB[];
};

layout(std430, set = 0, binding = 2) buffer BufferC {
    ELEM_TYPE_C dataC[];
};

void main() {
    // Wave and lane identification
    uint waveID = gl_LocalInvocationID.y;  // Wave index 0..3 (4 waves per workgroup)
    uint laneID = gl_LocalInvocationID.x;  // Lane index 0..31 within Wave32
    uint threadID = waveID * 32u + laneID; // Workgroup linear thread ID 0..127

    // 2x2 wave grid mapping to 32x32 spatial tile
    uint waveRow = (waveID / 2u) * 16u; // Row offset: 0 or 16
    uint waveCol = (waveID % 2u) * 16u; // Col offset: 0 or 16

    // Workgroup global matrix coordinates
    uint tileRow = gl_WorkGroupID.y * TILE_M;
    uint tileCol = gl_WorkGroupID.x * TILE_N;

    // Strides (fallback to N/K if leading dimensions are 0)
    uint lda = (pc.lda != 0u) ? pc.lda : pc.K;
    uint ldb = (pc.ldb != 0u) ? pc.ldb : pc.N;
    uint ldc = (pc.ldc != 0u) ? pc.ldc : pc.N;

    // Initialize Wave32 cooperative matrix accumulator (16x16 tile)
    coopmat<ELEM_TYPE_C, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC;
    matC = coopmat<ELEM_TYPE_C, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(ELEM_TYPE_C(0));

    // Iterate across K dimension in chunks of TILE_K
    for (uint kBlock = 0u; kBlock < pc.K; kBlock += TILE_K) {
        // 1. Cooperatively stage Tile A [32 x TILE_K] into LDS with Pad-2 alignment
        uint totalElementsA = TILE_M * TILE_K;
        for (uint i = threadID; i < totalElementsA; i += 128u) {
            uint r = i / TILE_K;
            uint c = i % TILE_K;
            uint globalRow = tileRow + r;
            uint globalCol = kBlock + c;

            ELEM_TYPE_A val = ELEM_TYPE_A(0);
            if (globalRow < pc.M && globalCol < pc.K) {
                val = dataA[globalRow * lda + globalCol];
            }
            ldsTileA[r * STRIDE_K + c] = val;
        }

        // 2. Cooperatively stage Tile B [TILE_K x 32] into LDS with Pad-2 alignment (stride = 34)
        uint totalElementsB = TILE_K * TILE_N;
        for (uint i = threadID; i < totalElementsB; i += 128u) {
            uint r = i / TILE_N;
            uint c = i % TILE_N;
            uint globalRow = kBlock + r;
            uint globalCol = tileCol + c;

            ELEM_TYPE_B val = ELEM_TYPE_B(0);
            if (globalRow < pc.K && globalCol < pc.N) {
                val = dataB[globalRow * ldb + globalCol];
            }
            ldsTileB[r * STRIDE_N + c] = val;
        }

        // Synchronize workgroup to ensure LDS staging is complete
        barrier();

        // 3. Load cooperative matrix fragments from Pad-2 aligned LDS
        coopmat<ELEM_TYPE_A, gl_ScopeSubgroup, 16, TILE_K, gl_MatrixUseA> matA;
        coopmat<ELEM_TYPE_B, gl_ScopeSubgroup, TILE_K, 16, gl_MatrixUseB> matB;

        uint offsetA = waveRow * STRIDE_K;
        uint offsetB = waveCol; // Stride is STRIDE_N (34 elements)

        coopMatLoad(matA, ldsTileA, offsetA, STRIDE_K, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB, ldsTileB, offsetB, STRIDE_N, gl_CooperativeMatrixLayoutRowMajor);

        // 4. Execute Wave Matrix Multiply-Accumulate (WMMA)
        matC = coopMatMulAdd(matA, matB, matC);

        // Synchronize before next LDS buffer write
        barrier();
    }

    // 5. Write out result matrix tile with alpha/beta scaling
    uint globalC_Row = tileRow + waveRow;
    uint globalC_Col = tileCol + waveCol;

    if (globalC_Row < pc.M && globalC_Col < pc.N) {
        uint globalOffsetC = globalC_Row * ldc + globalC_Col;

        // Apply alpha scaling if specified
        if (pc.alpha != 1.0) {
            matC = matC * ELEM_TYPE_C(pc.alpha);
        }

        // Apply beta accumulation if specified
        if (pc.beta != 0.0) {
            coopmat<ELEM_TYPE_C, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matPriorC;
            coopMatLoad(matPriorC, dataC, globalOffsetC, ldc, gl_CooperativeMatrixLayoutRowMajor);
            matC = matC + matPriorC * ELEM_TYPE_C(pc.beta);
        }

        // Store cooperative matrix accumulator to VRAM
        coopMatStore(matC, dataC, globalOffsetC, ldc, gl_CooperativeMatrixLayoutRowMajor);
    }
}

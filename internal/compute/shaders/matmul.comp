#version 450
// matmul.comp — y[P,out] = x[P,in] @ W[out,in]^T, all row-major f32.
//
// One workgroup processes one row t of X: it cooperatively stages X[t,:] into shared memory
// ONCE (in inDim-sized chunks), then each thread computes a strided set of outputs y[t,o] =
// dot(W[o,:], Xs[:]) reading the staged input from fast shared memory instead of re-reading
// the whole input vector from global memory for every output. For decode (P=1, out up to
// 49152, in=576) this is the dominant kernel; staging x cuts its global-memory traffic from
// O(out·in) reads of x to O(in). Still an Approx peer of cpuref (the per-output reduction is
// a plain serial sum — a different order than the model's fdot tree, hence Approx).
//
// SHARED_CAP bounds the staged chunk; inDim larger than the cap is handled by looping over
// chunks and accumulating, so the shader is correct for any inDim. Keep this universally
// admitted kernel free of cooperative-matrix capabilities: RADV can crash while creating a
// pipeline whose SPIR-V requests unsupported float32 cooperative-matrix operands. Specialized
// cooperative kernels must remain separately capability-gated.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Wbuf { float W[]; };
layout(std430, binding = 1) readonly  buffer Xbuf { float X[]; };
layout(std430, binding = 2) writeonly buffer Ybuf { float Y[]; };

layout(push_constant) uniform Push { int outDim; int inDim; int P; } pc;

const uint SHARED_CAP = 1024u;
shared float Xs[SHARED_CAP];

// Decode (P < 0 marks one row): every SHARED_CAP chunk's serial partial runs on
// its own lane, and the lane holding chunk 0 adds the partials in chunk order onto
// 0.0. That is the exact operation sequence of the staged path below, so the
// outputs are bit-identical while the work spreads over ceil(out / (256 / chunks))
// workgroups instead of one.
shared float Part[256];

void decodeChunks() {
    uint tid = gl_LocalInvocationID.x;
    uint in_ = uint(pc.inDim);
    uint out_ = uint(pc.outDim);
    uint chunks = (in_ + SHARED_CAP - 1u) / SHARED_CAP;
    uint perGroup = 256u / chunks;
    uint local = tid / chunks;
    uint c = tid - local * chunks;
    uint o = gl_WorkGroupID.x * perGroup + local;
    bool live = local < perGroup && o < out_;
    if (live) {
        uint c0 = c * SHARED_CAP;
        uint clen = min(SHARED_CAP, in_ - c0);
        uint wbase = o * in_ + c0;
        float acc = 0.0;
        uint i = 0u;
        // All sixteen loads issue before the in-order accumulation.
        for (; i + 16u <= clen; i += 16u) {
            float w0 = W[wbase + i + 0u], w1 = W[wbase + i + 1u], w2 = W[wbase + i + 2u], w3 = W[wbase + i + 3u];
            float w4 = W[wbase + i + 4u], w5 = W[wbase + i + 5u], w6 = W[wbase + i + 6u], w7 = W[wbase + i + 7u];
            float w8 = W[wbase + i + 8u], w9 = W[wbase + i + 9u], w10 = W[wbase + i + 10u], w11 = W[wbase + i + 11u];
            float w12 = W[wbase + i + 12u], w13 = W[wbase + i + 13u], w14 = W[wbase + i + 14u], w15 = W[wbase + i + 15u];
            float x0 = X[c0 + i + 0u], x1 = X[c0 + i + 1u], x2 = X[c0 + i + 2u], x3 = X[c0 + i + 3u];
            float x4 = X[c0 + i + 4u], x5 = X[c0 + i + 5u], x6 = X[c0 + i + 6u], x7 = X[c0 + i + 7u];
            float x8 = X[c0 + i + 8u], x9 = X[c0 + i + 9u], x10 = X[c0 + i + 10u], x11 = X[c0 + i + 11u];
            float x12 = X[c0 + i + 12u], x13 = X[c0 + i + 13u], x14 = X[c0 + i + 14u], x15 = X[c0 + i + 15u];
            acc += w0 * x0;
            acc += w1 * x1;
            acc += w2 * x2;
            acc += w3 * x3;
            acc += w4 * x4;
            acc += w5 * x5;
            acc += w6 * x6;
            acc += w7 * x7;
            acc += w8 * x8;
            acc += w9 * x9;
            acc += w10 * x10;
            acc += w11 * x11;
            acc += w12 * x12;
            acc += w13 * x13;
            acc += w14 * x14;
            acc += w15 * x15;
        }
        for (; i < clen; ++i) acc += W[wbase + i] * X[c0 + i];
        Part[tid] = acc;
    }
    barrier();
    if (live && c == 0u) {
        float y = 0.0;
        for (uint k = 0u; k < chunks; ++k) y += Part[tid + k];
        Y[o] = y;
    }
}

void main() {
    if (pc.P < 0) {
        decodeChunks();
        return;
    }
    uint t = gl_WorkGroupID.x;
    if (t >= uint(pc.P)) return;
    uint tid = gl_LocalInvocationID.x;
    uint in_ = uint(pc.inDim);
    uint out_ = uint(pc.outDim);
    uint xbase = t * in_;

    for (uint o = tid; o < out_; o += 256u) {
        Y[t * out_ + o] = 0.0;
    }

    for (uint c0 = 0u; c0 < in_; c0 += SHARED_CAP) {
        uint clen = min(SHARED_CAP, in_ - c0);
        for (uint i = tid; i < clen; i += 256u) Xs[i] = X[xbase + c0 + i];
        barrier();
        for (uint o = tid; o < out_; o += 256u) {
            uint wbase = o * in_ + c0;
            float acc = 0.0;
            for (uint i = 0u; i < clen; ++i) acc += W[wbase + i] * Xs[i];
            Y[t * out_ + o] += acc;
        }
        barrier();
    }
}

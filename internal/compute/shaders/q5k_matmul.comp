#version 450

// q5k_matmul.comp - portable GGML Q5_K matrix multiplication.
//
// Y[P,outDim] = X[P,inDim] * W[outDim,inDim]^T. W remains in the
// checkpoint's packed Q5_K representation: every 256 weights occupy 176
// bytes (2-byte f16 d, 2-byte f16 dmin, 12 packed 6-bit scale/min bytes,
// 32 high-bit bytes, and 128 low-nibble bytes). This mirrors dequantQ5K in
// quant_q4k.go: per super-block w = d*scale*(nibble|16*hi) - dmin*min, with
// ScaleMinK4 6-bit geometry.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Q5K { uint raw[]; };
layout(std430, set = 0, binding = 1) readonly buffer X   { float x[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Y  { float y[]; };

layout(push_constant) uniform PC {
    int outDim;
    int inDim;
    int tokens;
} pc;

uint byteAt(uint offset) {
    uint word = raw[offset >> 2u];
    return (word >> ((offset & 3u) * 8u)) & 255u;
}

float halfAt(uint offset) {
    uint bits = byteAt(offset) | (byteAt(offset + 1u) << 8u);
    return unpackHalf2x16(bits).x;
}

void scaleMinK4(uint sc, uint j, out uint scale, out uint minv) {
    if (j < 4u) {
        scale = byteAt(sc + j) & 63u;
        minv = byteAt(sc + j + 4u) & 63u;
        return;
    }
    scale = (byteAt(sc + j + 4u) & 0x0fu) | ((byteAt(sc + j - 4u) >> 6u) << 4u);
    minv = (byteAt(sc + j + 4u) >> 4u) | ((byteAt(sc + j) >> 6u) << 4u);
}

void main() {
    uint globalIndex = gl_GlobalInvocationID.x;
    uint outDim = uint(pc.outDim);
    uint row = globalIndex % outDim;
    uint token = globalIndex / outDim;
    if (token >= uint(pc.tokens)) return;

    uint blocks = uint(pc.inDim) / 256u;
    float sum = 0.0;
    for (uint sb = 0u; sb < blocks; ++sb) {
        uint base = (row * blocks + sb) * 176u;
        float d = halfAt(base + 0u);
        float dm = halfAt(base + 2u);
        uint sc = base + 4u;
        uint qh = base + 16u;
        uint ql = base + 48u;
        uint xBlock = token * uint(pc.inDim) + sb * 256u;

        for (uint group = 0u; group < 4u; ++group) {
            uint s1, m1, s2, m2;
            scaleMinK4(sc, group * 2u, s1, m1);
            scaleMinK4(sc, group * 2u + 1u, s2, m2);
            uint hiBit1 = 1u << (group * 2u);
            uint hiBit2 = 1u << (group * 2u + 1u);
            uint qlBase = ql + group * 32u;
            uint valueBase = xBlock + group * 64u;

            for (uint l = 0u; l < 32u; ++l) {
                uint low = byteAt(qlBase + l);
                uint hi1 = (byteAt(qh + l) & hiBit1) != 0u ? 16u : 0u;
                uint hi2 = (byteAt(qh + l) & hiBit2) != 0u ? 16u : 0u;
                float w1 = d * float(s1) * float((low & 15u) + hi1) - dm * float(m1);
                float w2 = d * float(s2) * float((low >> 4u) + hi2) - dm * float(m2);
                sum += w1 * x[valueBase + l];
                sum += w2 * x[valueBase + 32u + l];
            }
        }
    }
    y[token * outDim + row] = sum;
}
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

// Decode-only Q8_0 input projection for Qwen3.5/3.8 Gated-DeltaNet. The four
// logical matrices share one dispatch and one output-row address space. Eight
// output rows share each workgroup; activation quantization is windowed so the
// shader supports hidden dimensions larger than its 2,048-element LDS tile.
layout(local_size_x = 256) in;

const uint BLOCK = 32u;
const uint SHARED_CAP = 2048u;
const uint WIN_BLOCKS = SHARED_CAP / BLOCK;
const uint PARTIAL_STRIDE = WIN_BLOCKS + 2u; // Pad-2 avoids 64-column bank aliasing.

layout(std430, binding = 0) readonly buffer W0q { int8_t W0codes[]; };
layout(std430, binding = 1) readonly buffer W0s { float W0scale[]; };
layout(std430, binding = 2) readonly buffer W1q { int8_t W1codes[]; };
layout(std430, binding = 3) readonly buffer W1s { float W1scale[]; };
layout(std430, binding = 4) readonly buffer W2q { int8_t W2codes[]; };
layout(std430, binding = 5) readonly buffer W2s { float W2scale[]; };
layout(std430, binding = 6) readonly buffer W3q { int8_t W3codes[]; };
layout(std430, binding = 7) readonly buffer W3s { float W3scale[]; };
layout(std430, binding = 8) readonly buffer Xb { float X[]; };
layout(std430, binding = 9) writeonly buffer Y0b { float Y0[]; };
layout(std430, binding = 10) writeonly buffer Y1b { float Y1[]; };
layout(std430, binding = 11) writeonly buffer Y2b { float Y2[]; };
layout(std430, binding = 12) writeonly buffer Y3b { float Y3[]; };

layout(push_constant) uniform Push {
    int out0;
    int out1;
    int out2;
    int out3;
    int inDim;
} pc;

shared int8_t Xq[SHARED_CAP];
shared float Xs[WIN_BLOCKS];
shared float partial[8u * PARTIAL_STRIDE];

int8_t q8round(float x) {
    int t = int(x);
    float f = x - float(t);
    if (f >= 0.5) t += 1; else if (f <= -0.5) t -= 1;
    return int8_t(clamp(t, -127, 127));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid % BLOCK;
    uint row = tid / BLOCK;
    uint outputRow = gl_WorkGroupID.x * 8u + row;
    uint out0 = uint(pc.out0);
    uint out1 = uint(pc.out1);
    uint out2 = uint(pc.out2);
    uint totalOut = out0 + out1 + out2 + uint(pc.out3);
    uint in_ = uint(pc.inDim);
    uint nblk = in_ / BLOCK;
    float acc = 0.0;

    for (uint wb = 0u; wb < nblk; wb += WIN_BLOCKS) {
        uint winBlocks = min(WIN_BLOCKS, nblk - wb);
        for (uint b = tid; b < winBlocks; b += 256u) {
            uint base = b * BLOCK;
            uint gbase = (wb + b) * BLOCK;
            float amax = 0.0;
            for (uint i = 0u; i < BLOCK; ++i)
                amax = max(amax, abs(X[gbase + i]));
            float d = amax / 127.0;
            Xs[b] = d;
            float inv = d > 0.0 ? 1.0 / d : 0.0;
            for (uint i = 0u; i < BLOCK; ++i)
                Xq[base + i] = d > 0.0 ? q8round(X[gbase + i] * inv) : int8_t(0);
        }
        barrier();

        if (outputRow < totalOut) {
            uint localRow;
            for (uint lb = lane; lb < winBlocks; lb += BLOCK) {
                uint block = wb + lb;
                uint cb;
                float ws;
                if (outputRow < out0) {
                    localRow = outputRow;
                    cb = localRow * in_ + block * BLOCK;
                    ws = W0scale[localRow * nblk + block];
                } else if (outputRow < out0 + out1) {
                    localRow = outputRow - out0;
                    cb = localRow * in_ + block * BLOCK;
                    ws = W1scale[localRow * nblk + block];
                } else if (outputRow < out0 + out1 + out2) {
                    localRow = outputRow - out0 - out1;
                    cb = localRow * in_ + block * BLOCK;
                    ws = W2scale[localRow * nblk + block];
                } else {
                    localRow = outputRow - out0 - out1 - out2;
                    cb = localRow * in_ + block * BLOCK;
                    ws = W3scale[localRow * nblk + block];
                }
                uint xb = lb * BLOCK;
                int s0 = 0, s1 = 0, s2 = 0, s3 = 0;
                for (uint i = 0u; i < BLOCK; i += 4u) {
                    if (outputRow < out0) {
                        s0 += int(W0codes[cb + i]) * int(Xq[xb + i]);
                        s1 += int(W0codes[cb + i + 1u]) * int(Xq[xb + i + 1u]);
                        s2 += int(W0codes[cb + i + 2u]) * int(Xq[xb + i + 2u]);
                        s3 += int(W0codes[cb + i + 3u]) * int(Xq[xb + i + 3u]);
                    } else if (outputRow < out0 + out1) {
                        s0 += int(W1codes[cb + i]) * int(Xq[xb + i]);
                        s1 += int(W1codes[cb + i + 1u]) * int(Xq[xb + i + 1u]);
                        s2 += int(W1codes[cb + i + 2u]) * int(Xq[xb + i + 2u]);
                        s3 += int(W1codes[cb + i + 3u]) * int(Xq[xb + i + 3u]);
                    } else if (outputRow < out0 + out1 + out2) {
                        s0 += int(W2codes[cb + i]) * int(Xq[xb + i]);
                        s1 += int(W2codes[cb + i + 1u]) * int(Xq[xb + i + 1u]);
                        s2 += int(W2codes[cb + i + 2u]) * int(Xq[xb + i + 2u]);
                        s3 += int(W2codes[cb + i + 3u]) * int(Xq[xb + i + 3u]);
                    } else {
                        s0 += int(W3codes[cb + i]) * int(Xq[xb + i]);
                        s1 += int(W3codes[cb + i + 1u]) * int(Xq[xb + i + 1u]);
                        s2 += int(W3codes[cb + i + 2u]) * int(Xq[xb + i + 2u]);
                        s3 += int(W3codes[cb + i + 3u]) * int(Xq[xb + i + 3u]);
                    }
                }
                partial[row * PARTIAL_STRIDE + lb] = float((s0 + s1) + (s2 + s3)) * ws;
            }
        }
        barrier();
        if (lane == 0u && outputRow < totalOut) {
            for (uint lb = 0u; lb < winBlocks; ++lb)
                acc += partial[row * PARTIAL_STRIDE + lb] * Xs[lb];
        }
        barrier();
    }

    if (lane != 0u || outputRow >= totalOut) return;
    if (outputRow < out0) {
        Y0[outputRow] = acc;
    } else if (outputRow < out0 + out1) {
        Y1[outputRow - out0] = acc;
    } else if (outputRow < out0 + out1 + out2) {
        Y2[outputRow - out0 - out1] = acc;
    } else {
        Y3[outputRow - out0 - out1 - out2] = acc;
    }
}


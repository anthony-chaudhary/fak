#version 450

// One workgroup owns one value head. All lanes finish the recurrent-state
// update before any lane reads sibling columns for the gated RMS norm.
layout(local_size_x = 64) in;
layout(set=0,binding=0) readonly buffer ConvOut { float convOut[]; };
layout(set=0,binding=1) readonly buffer Z { float z[]; };
layout(set=0,binding=2) readonly buffer B { float beta[]; };
layout(set=0,binding=3) readonly buffer A { float alpha[]; };
layout(set=0,binding=4) readonly buffer ALog { float aLog[]; };
layout(set=0,binding=5) readonly buffer DTBias { float dtBias[]; };
layout(set=0,binding=6) readonly buffer Norm { float norm[]; };
layout(set=0,binding=7) buffer State { float state[]; };
layout(set=0,binding=8) writeonly buffer Core { float core[]; };
layout(push_constant) uniform PC { int tokens; int convDim; int nK; int nV; int kHd; int vHd; float eps; } pc;

shared float gated[1024];
shared float rmsInv;

float softplus(float x) { return x > 20.0 ? x : log(1.0 + exp(x)); }

void main() {
    int h = int(gl_WorkGroupID.x);
    int lane = int(gl_LocalInvocationID.x);
    if (h >= pc.nV) return;
    int repeat = pc.nV / pc.nK;
    int kh = h / repeat;
    int keyDim = pc.nK * pc.kHd;
    for (int t = 0; t < pc.tokens; ++t) {
        int base = t * pc.convDim;
        float q2 = 0.0, k2 = 0.0;
        for (int i = 0; i < pc.kHd; ++i) {
            float qv = convOut[base + kh * pc.kHd + i];
            float kv = convOut[base + keyDim + kh * pc.kHd + i];
            q2 += qv*qv; k2 += kv*kv;
        }
        float qInv = inversesqrt(q2 + pc.eps);
        float kInv = inversesqrt(k2 + pc.eps);
        float bv = 1.0 / (1.0 + exp(-beta[t * pc.nV + h]));
        float av = exp(-exp(aLog[h]) * softplus(alpha[t * pc.nV + h] + dtBias[h]));

        for (int d = lane; d < pc.vHd; d += 64) {
            float vv = convOut[base + 2 * keyDim + h * pc.vHd + d];
            float acc = 0.0;
            for (int i = 0; i < pc.kHd; ++i) {
                float qv = convOut[base + kh * pc.kHd + i] * qInv;
                float kv = convOut[base + keyDim + kh * pc.kHd + i] * kInv;
                int si = (h * pc.kHd + i) * pc.vHd + d;
                float sv = av * state[si] + bv * kv * vv;
                state[si] = sv;
                acc += qv * sv;
            }
            gated[d] = acc * (1.0 / (1.0 + exp(-z[t * pc.nV * pc.vHd + h * pc.vHd + d])));
        }
        barrier();

        if (lane == 0) {
            float sum = 0.0;
            for (int d = 0; d < pc.vHd; ++d) sum += gated[d] * gated[d];
            rmsInv = inversesqrt(sum / float(pc.vHd) + pc.eps);
        }
        barrier();

        for (int d = lane; d < pc.vHd; d += 64)
            core[t * pc.nV * pc.vHd + h * pc.vHd + d] = gated[d] * rmsInv * norm[h * pc.vHd + d];
        barrier();
    }
}

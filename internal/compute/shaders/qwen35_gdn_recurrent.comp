#version 450

// One workgroup owns one value head. All lanes finish the recurrent-state
// update before any lane reads sibling columns for the gated RMS norm.
layout(local_size_x = 64) in;
layout(set=0,binding=0) readonly buffer ConvOut { float convOut[]; };
layout(set=0,binding=1) readonly buffer Z { float z[]; };
layout(set=0,binding=2) readonly buffer B { float beta[]; };
layout(set=0,binding=3) readonly buffer A { float alpha[]; };
layout(set=0,binding=4) readonly buffer ALog { float aLog[]; };
layout(set=0,binding=5) readonly buffer DTBias { float dtBias[]; };
layout(set=0,binding=6) readonly buffer Norm { float norm[]; };
layout(set=0,binding=7) buffer State { float state[]; };
layout(set=0,binding=8) writeonly buffer Core { float core[]; };
layout(push_constant) uniform PC { int tokens; int convDim; int nK; int nV; int kHd; int vHd; float eps; } pc;

shared float readout[1024];
shared float rmsInv;
// Cooperative Q/K norm reduction scratch: [0] = sum(q^2), [1] = sum(k^2).
// One workgroup owns one value head, so a single workgroup reduction per
// value-head group replaces the redundant per-lane walk of the full key-head
// dimension. qkSum broadcasts the two reduced norms after the tree.
shared float qkPart[2][64];
shared float qkSum[2];
// Cooperative value-state RMS reduction scratch. The lane-0 serial walk of
// readout[] left every other lane idle behind two barriers; each lane now
// accumulates a strided slice of readout[d]^2, the shared tree reduces across
// the group, and lane 0 broadcasts one rmsInv. The gated output equation is
// unchanged and each value head still has exactly one normalization factor.
shared float rmsPart[64];

float silu(float x) { return x / (1.0 + exp(-x)); }
float softplus(float x) { return x > 20.0 ? x : log(1.0 + exp(x)); }

void main() {
    int h = int(gl_WorkGroupID.x);
    int lane = int(gl_LocalInvocationID.x);
    if (h >= pc.nV) return;
    int repeat = pc.nV / pc.nK;
    int kh = h / repeat;
    int keyDim = pc.nK * pc.kHd;
    for (int t = 0; t < pc.tokens; ++t) {
        int base = t * pc.convDim;

        // Cooperative Q/K squared-norm reduction: each lane accumulates a
        // strided slice, then a shared-memory tree reduces across the group.
        // This replaces the previous redundant per-lane walk over pc.kHd
        // (all 64 invocations computed the identical q2/k2).
        float q2p = 0.0, k2p = 0.0;
        for (int i = lane; i < pc.kHd; i += 64) {
            float qv = convOut[base + kh * pc.kHd + i];
            float kv = convOut[base + keyDim + kh * pc.kHd + i];
            q2p += qv*qv; k2p += kv*kv;
        }
        qkPart[0][lane] = q2p;
        qkPart[1][lane] = k2p;
        barrier();
        for (int s = 32; s > 0; s >>= 1) {
            if (lane < s) {
                qkPart[0][lane] += qkPart[0][lane + s];
                qkPart[1][lane] += qkPart[1][lane + s];
            }
            barrier();
        }
        if (lane == 0) {
            // Q/K L2 normalization has its own fixed epsilon; pc.eps belongs to
            // the output RMS norm and may differ (model.l2normInto uses 1e-6).
            qkSum[0] = inversesqrt(qkPart[0][0] + 1e-6);
            qkSum[1] = inversesqrt(qkPart[1][0] + 1e-6);
        }
        barrier();
        float qInv = qkSum[0] * inversesqrt(float(pc.kHd));
        float kInv = qkSum[1];
        float bv = 1.0 / (1.0 + exp(-beta[t * pc.nV + h]));
        float av = exp(-exp(aLog[h]) * softplus(alpha[t * pc.nV + h] + dtBias[h]));

        for (int d = lane; d < pc.vHd; d += 64) {
            float vv = convOut[base + 2 * keyDim + h * pc.vHd + d];
            float kvmem = 0.0;
            for (int i = 0; i < pc.kHd; ++i) {
                float kv = convOut[base + keyDim + kh * pc.kHd + i] * kInv;
                int si = (h * pc.kHd + i) * pc.vHd + d;
                state[si] *= av;
                kvmem += state[si] * kv;
            }
            float delta = (vv - kvmem) * bv;
            float acc = 0.0;
            for (int i = 0; i < pc.kHd; ++i) {
                float qv = convOut[base + kh * pc.kHd + i] * qInv;
                float kv = convOut[base + keyDim + kh * pc.kHd + i] * kInv;
                int si = (h * pc.kHd + i) * pc.vHd + d;
                state[si] += kv * delta;
                acc += qv * state[si];
            }
            readout[d] = acc;
        }
        barrier();

        // Cooperative value-state RMS reduction: each lane accumulates a
        // strided slice of readout[]^2, then the shared tree reduces across the
        // group and lane 0 broadcasts one rmsInv for this value head. This
        // replaces the lane-0 serial walk that left the other 63 lanes idle.
        float rmsPartial = 0.0;
        for (int d = lane; d < pc.vHd; d += 64) rmsPartial += readout[d] * readout[d];
        rmsPart[lane] = rmsPartial;
        barrier();
        for (int s = 32; s > 0; s >>= 1) {
            if (lane < s) rmsPart[lane] += rmsPart[lane + s];
            barrier();
        }
        if (lane == 0) {
            rmsInv = inversesqrt(rmsPart[0] / float(pc.vHd) + pc.eps);
        }
        barrier();

        for (int d = lane; d < pc.vHd; d += 64) {
            float zv = z[t * pc.nV * pc.vHd + h * pc.vHd + d];
            core[t * pc.nV * pc.vHd + h * pc.vHd + d] = norm[d] * (readout[d] * rmsInv) * silu(zv);
        }
        barrier();
    }
}
// The work split, bindings and push constants are fak's (q2k_matvec.comp), so the shim
// selects the pipeline per weight dtype without changing callers.
//
// Modes, selected by auxOutDim (x is already normalized/activated by the caller):
//    0: Y[t, :] = W0 * X[t, :]   for t in [0, tokens)  (tokens on dispatch Y)
//   -1: Y[:]   += W0 * x                                (residual accumulate, tokens == 1)
//   >0: Y = W0 * x, Y1 = W1 * x  (W1 has auxOutDim rows) (gate/up pair, tokens == 1)
//
// IQ4_XS superblock (256 weights, 136 bytes): d f16, scales_h u16, scales_l[4], qs[128].
// Sub-block ib (32 weights) has 6-bit scale ls = scales_l nibble | scales_h 2 bits << 4,
// dl = d * (ls - 32); weight ib*32 + j is kvalues[qs[16*ib + j] & 15] and weight
// ib*32 + 16 + j is kvalues[qs[16*ib + j] >> 4], j in 0..15.
//
// Work split: each subgroup owns NR consecutive rows at a time and strides over row groups.
// Sixteen lanes cover one superblock: lane = 32-weight sub-block * 2 + half, each lane owning
// 16 consecutive weights, so gl_SubgroupSize/16 superblocks are in flight per row per step.
// The activation slice is loaded once per step and reused for all NR rows; each row is
// reduced with one subgroupAdd, so a row group pays no workgroup barrier. laneDot is called
// with a constant buffer selector so each load reads one binding.
layout(local_size_x = 64) in;

const uint NR = 8u;
const uint LANES = 64u;
const uint BLOCK_BYTES = 136u;

layout(std430, set = 0, binding = 0) readonly buffer W0buf { uint raw[]; };
layout(std430, set = 0, binding = 1) readonly buffer X     { vec4 x4[]; };
layout(std430, set = 0, binding = 2) readonly buffer U     { vec4 u4[]; };
layout(std430, set = 0, binding = 3) buffer Y              { float y[]; };
layout(std430, set = 0, binding = 4) readonly buffer W1buf { uint raw1[]; };
layout(std430, set = 0, binding = 5) readonly buffer Nbuf  { vec4 norm4[]; };
layout(std430, set = 0, binding = 6) writeonly buffer Y1buf { float y1[]; };

layout(push_constant) uniform PC {
    int outDim;
    int inDim;
    int tokens;
    int auxOutDim;
    float eps;
} pc;

// Byte-addressed reads of the packed stream (every IQ block size is even, so a 16-bit
// field never straddles a 32-bit word).
uint wword(bool s, uint i) { return s ? raw1[i] : raw[i]; }
uint u8at(bool s, uint off) { return (wword(s, off >> 2u) >> ((off & 3u) << 3u)) & 255u; }
uint u16at(bool s, uint off) { return (wword(s, off >> 2u) >> ((off & 2u) << 3u)) & 65535u; }
uint u32at(bool s, uint off) { return u16at(s, off) | (u16at(s, off + 2u) << 16u); }
float f16at(bool s, uint off) { return unpackHalf2x16(u16at(s, off)).x; }
vec4 bytes4(uint w) {
    return vec4(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u), float(w >> 24u));
}
vec4 signs4(uint sg) {
    return vec4((sg & 1u) != 0u ? -1.0 : 1.0, (sg & 2u) != 0u ? -1.0 : 1.0,
                (sg & 4u) != 0u ? -1.0 : 1.0, (sg & 8u) != 0u ? -1.0 : 1.0);
}
// ksigns_iq2xs: 7 stored sign bits plus an even-parity eighth bit.
uint ksigns(uint s7) { return s7 | ((uint(bitCount(s7)) & 1u) << 7u); }

shared float kv[16];
const float KVALUES[16] = float[16](-127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
                                    1.0, 13.0, 25.0, 38.0, 53.0, 69.0, 89.0, 113.0);

float laneDot(bool s, uint b, uint ib, uint hf, vec4 xv[4]) {
    // IQ4_XS blocks are 136 bytes, so b is word-aligned: read whole words.
    uint wb = b >> 2u;
    uint w0 = wword(s, wb);
    uint w1 = wword(s, wb + 1u);
    float d = unpackHalf2x16(w0).x;
    uint sh = w0 >> 16u;
    uint sl = (w1 >> (8u * (ib >> 1u) + 4u * (ib & 1u))) & 15u;
    float dl = d * float(int(sl | (((sh >> (2u * ib)) & 3u) << 4u)) - 32);
    uint shift = 4u * hf;
    float sum = 0.0;
    for (uint k = 0u; k < 4u; ++k) {
        uint w = wword(s, wb + 2u + ib * 4u + k) >> shift;
        vec4 qv = vec4(kv[w & 15u], kv[(w >> 8u) & 15u], kv[(w >> 16u) & 15u], kv[(w >> 24u) & 15u]);
        sum += dot(qv, xv[k]);
    }
    return dl * sum;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    int mode = pc.auxOutDim > 0 ? 2 : (pc.auxOutDim < 0 ? 1 : 0);
    uint rows0 = uint(pc.outDim);
    uint rows1 = mode == 2 ? uint(pc.auxOutDim) : 0u;
    uint rg0 = (rows0 + NR - 1u) / NR;
    uint rgTotal = rg0 + (rows1 + NR - 1u) / NR;
    uint nsg = gl_NumSubgroups;
    if (gl_WorkGroupID.x * nsg >= rgTotal) return;
    if (tid < 16u) kv[tid] = KVALUES[tid];
    barrier();

    uint tok = gl_WorkGroupID.y;
    uint nsb = uint(pc.inDim) / 256u;
    uint xBase = tok * (uint(pc.inDim) >> 2u);
    uint lane = gl_SubgroupInvocationID;
    uint t16 = lane & 15u;
    uint ib32 = t16 >> 1u;
    uint hf = t16 & 1u;
    uint sbStep = gl_SubgroupSize >> 4u;

    for (uint rg = gl_WorkGroupID.x * nsg + gl_SubgroupID; rg < rgTotal; rg += gl_NumWorkGroups.x * nsg) {
        bool second = rg >= rg0;
        uint rowBase = (second ? rg - rg0 : rg) * NR;
        uint rowsOut = second ? rows1 : rows0;
        uint rowLast = rowsOut - 1u;

        float acc[NR];
        for (uint r = 0u; r < NR; ++r) acc[r] = 0.0;
        for (uint sb = lane >> 4u; sb < nsb; sb += sbStep) {
            vec4 xv[4];
            uint xi = xBase + ((sb * 256u + ib32 * 32u + hf * 16u) >> 2u);
            for (uint k = 0u; k < 4u; ++k) xv[k] = x4[xi + k];
            if (second) {
                for (uint r = 0u; r < NR; ++r)
                    acc[r] += laneDot(true, (min(rowBase + r, rowLast) * nsb + sb) * BLOCK_BYTES, ib32, hf, xv);
            } else {
                for (uint r = 0u; r < NR; ++r)
                    acc[r] += laneDot(false, (min(rowBase + r, rowLast) * nsb + sb) * BLOCK_BYTES, ib32, hf, xv);
            }
        }

        for (uint r = 0u; r < NR; ++r) {
            float v = subgroupAdd(acc[r]);
            uint row = rowBase + r;
            if (lane == 0u && row < rowsOut) {
                if (mode == 1) y[row] += v;
                else if (second) y1[row] = v;
                else y[tok * rows0 + row] = v;
            }
        }
    }
}

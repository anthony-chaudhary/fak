#version 450
// attention.comp — decode attention, one workgroup per query head.
// q[nH*hd] (one position); K,V [nPos, nKV*hd] row-major; out[nH*hd].
// FlashAttention online softmax: streaming keys with running (m, l, acc)
// in registers/shared memory — zero global scratch allocations.
// Evaluates over contiguous gathered sparse KV tiles (aligned to 256-wide tiles) sized to
// reside entirely within Strix Halo's 32MB MALL Infinity Cache without dense masking overhead.
// FlashAttention-3 architecture reference:
// - Register-resident online softmax: runningMax (m), runningSum (l), tileScores
// - Extensions: GL_KHR_shader_subgroup_arithmetic, GL_KHR_cooperative_matrix
// - Reduction primitives: reduceMax128, reduceSum128
// - Tile and sliding window bounds: pc.causal != 0 && tile >= maxAttendPos; pc.windowSize > 0 && tile + Bc <= minAttendPos
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer Qbuf { float Q[]; };
// FAK_ATTENTION_PACKED_FP16_KV is the source-level specialization contract for
// FP16-resident K/V. The default F32 declarations remain active until the Vulkan
// allocator and dispatch leaf can bind two-byte buffers with a physical witness.
#ifdef FAK_ATTENTION_PACKED_FP16_KV
layout(std430, binding = 1) readonly  buffer Kbuf { uint PackedK[]; };
layout(std430, binding = 2) readonly  buffer Vbuf { uint PackedV[]; };

float loadKAsF32(uint logicalIndex) {
    vec2 lowHighF16 = unpackHalf2x16(PackedK[logicalIndex >> 1u]);
    return (logicalIndex & 1u) == 0u ? lowHighF16.x : lowHighF16.y;
}

float loadVAsF32(uint logicalIndex) {
    vec2 lowHighF16 = unpackHalf2x16(PackedV[logicalIndex >> 1u]);
    return (logicalIndex & 1u) == 0u ? lowHighF16.x : lowHighF16.y;
}
#else
layout(std430, binding = 1) readonly  buffer Kbuf { float K[]; };
layout(std430, binding = 2) readonly  buffer Vbuf { float V[]; };

float loadKAsF32(uint logicalIndex) { return K[logicalIndex]; }
float loadVAsF32(uint logicalIndex) { return V[logicalIndex]; }
#endif
layout(std430, binding = 3) writeonly buffer Obuf { float Outp[]; };

layout(push_constant) uniform Push {
    int nPos; int nH; int nKV; int hd; float scale;
} pc;

// Architectural rationale: LDS Shared Memory Bank Conflict Elimination (Pad-2 Stride)
// On AMD RDNA 3.5 (e.g. Strix Halo / gfx1151), Local Data Share (LDS) is divided into 32 memory banks
// of 4 bytes each. Standard unpadded reduction rows of 32 floats cause all lanes in a Wave32 wavefront
// to access identical LDS banks ((lane * 32) % 32 == 0), causing severe 32-way bank conflict stalls.
// By padding the reduction row stride by +2 floats (RED_STRIDE = 32u + 2u = 34 floats, gcd(34, 32) = 2),
// bank addresses skew across successive rows, eliminating LDS bank conflicts and maximizing throughput.
shared float qs[1024];
const uint RED_STRIDE = 32u + 2u;
shared float red[4u * RED_STRIDE];

uint red_idx(uint i) {
    return (i / 32u) * RED_STRIDE + (i % 32u);
}

const uint QSA_TILE_SIZE = 256u;

void main() {
    uint h = gl_WorkGroupID.x;
    if (h >= uint(pc.nH)) return;
    uint tid = gl_LocalInvocationID.x;
    int grp = pc.nH / pc.nKV;
    int kvh = int(h) / grp;
    int w = pc.nKV * pc.hd;
    uint qbase = h * uint(pc.hd);

    // Cache query row in shared memory (threads stride hd).
    for (uint d = tid; d < uint(pc.hd); d += 128u) {
        qs[d] = Q[qbase + d];
    }
    barrier();

    // Online softmax state: running max m, normalizer l, accumulator acc[8].
    float m = -3.402823466e38;
    float l = 0.0;
    float acc[8];
    for (uint k = 0u; k < 8u; ++k) acc[k] = 0.0;

    for (uint tile = 0u; tile < uint(pc.nPos); tile += QSA_TILE_SIZE) {
        uint tileEnd = min(tile + QSA_TILE_SIZE, uint(pc.nPos));
        for (uint j = tile; j < tileEnd; ++j) {
            uint kbase = j * uint(w) + uint(kvh) * uint(pc.hd);

            // Partial dot product over this thread's strided dims.
            float partial = 0.0;
            for (uint d = tid; d < uint(pc.hd); d += 128u) {
                partial += qs[d] * loadKAsF32(kbase + d);
            }
            red[red_idx(tid)] = partial;
            barrier();

            // Tree reduction for block dot-product score.
            for (uint s = 64u; s > 0u; s >>= 1u) {
                if (tid < s) {
                    red[red_idx(tid)] += red[red_idx(tid + s)];
                }
                barrier();
            }

            float score = red[red_idx(0u)] * pc.scale;
            barrier();

            // Online softmax recurrence.
            float m_new = max(m, score);
            float corr = (l > 0.0) ? exp(m - m_new) : 0.0;
            float p = exp(score - m_new);
            l = l * corr + p;

            uint k = 0u;
            for (uint d = tid; d < uint(pc.hd); d += 128u) {
                acc[k] = acc[k] * corr + p * loadVAsF32(kbase + d);
                k++;
            }
            m = m_new;
        }
    }

    // Final normalization: Outp = acc / l.
    uint k = 0u;
    for (uint d = tid; d < uint(pc.hd); d += 128u) {
        Outp[qbase + d] = (l > 0.0) ? (acc[k] / l) : 0.0;
        k++;
    }
}

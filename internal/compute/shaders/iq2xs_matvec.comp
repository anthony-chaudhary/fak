    uint tid = gl_LocalInvocationID.x;
    for (uint i = tid; i < 512u; i += LANES) iq2xs_grid[i] = iq2xs_grid_const[i];
    barrier();

    int mode = pc.auxOutDim > 0 ? 2 : (pc.auxOutDim < 0 ? 1 : 0);
    uint tok = gl_WorkGroupID.y;
    uint rg0 = (uint(pc.outDim) + ROWS - 1u) / ROWS;
    uint rgTotal = rg0 + (mode == 2 ? (uint(pc.auxOutDim) + ROWS - 1u) / ROWS : 0u);
    uint inDim = uint(pc.inDim);
    uint nsb = inDim / 256u;
    uint xBase = tok * (inDim >> 2u);
    uint t16 = tid & 15u;
    uint ib32 = t16 >> 1u;
    uint hf = t16 & 1u;

    for (uint rg = gl_WorkGroupID.x; rg < rgTotal; rg += gl_NumWorkGroups.x) {
        bool second = rg >= rg0;
        uint rowBase = (second ? rg - rg0 : rg) * ROWS;
        uint rowsOut = second ? uint(pc.auxOutDim) : uint(pc.outDim);

        float acc[ROWS];
        for (uint r = 0u; r < ROWS; ++r) acc[r] = 0.0;
        for (uint sb = tid >> 4u; sb < nsb; sb += LANES / 16u) {
            vec4 xv[4];
            uint xi = xBase + ((sb * 256u + ib32 * 32u + hf * 16u) >> 2u);
            for (uint k = 0u; k < 4u; ++k) xv[k] = x4[xi + k];
            for (uint r = 0u; r < ROWS; ++r) {
                uint row = rowBase + r;
                if (row >= rowsOut) break;
                acc[r] += laneDot(second, (row * nsb + sb) * BLOCK_BYTES, ib32, hf, xv);
            }
        }

        for (uint r = 0u; r < ROWS; ++r) red[r * LANES + tid] = acc[r];
        barrier();
        for (uint stride = LANES / 2u; stride > 0u; stride >>= 1u) {
            if (tid < stride) {
                for (uint r = 0u; r < ROWS; ++r) red[r * LANES + tid] += red[r * LANES + tid + stride];
            }
            barrier();
        }
        if (tid < ROWS) {
            uint row = rowBase + tid;
            if (row < rowsOut) {
                float v = red[tid * LANES];
                if (mode == 1) y[row] += v;
                else if (second) y1[row] = v;
                else y[tok * uint(pc.outDim) + row] = v;
            }
        }
        barrier();
    }

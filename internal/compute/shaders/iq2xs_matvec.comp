float laneDot(bool s, uint b, uint ib32, uint hf, vec4 xv[4]) {
    float d = f16at(s, b);
    uint sc = u8at(s, b + 66u + ib32);
    float db = d * (0.5 + float((sc >> (4u * hf)) & 15u)) * 0.25;
    float sum = 0.0;
    for (uint k = 0u; k < 2u; ++k) {
        uint l = 2u * hf + k;
        uint q = u16at(s, b + 2u + 2u * (4u * ib32 + l));
        uvec2 g = iq2xs_grid[q & 511u];
        uint sg = ksigns(q >> 9u);
        sum += dot(bytes4(g.x) * signs4(sg), xv[2u * k]);
        sum += dot(bytes4(g.y) * signs4(sg >> 4u), xv[2u * k + 1u]);
    }
    return db * sum;
}


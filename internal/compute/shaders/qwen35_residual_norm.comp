#version 450
// Derived from fak's Apache-2.0 add.comp and rmsnorm.comp. Update the
// independently owned residual in F32 before the unchanged per-row RMS tree.
layout(local_size_x = 256) in;
layout(std430,binding=0) coherent buffer Xbuf { float X[]; };
layout(std430,binding=1) readonly buffer Dbuf { float D[]; };
layout(std430,binding=2) readonly buffer Wbuf { float W[]; };
layout(std430,binding=3) writeonly buffer Ybuf { float Y[]; };
layout(push_constant) uniform Push { int rows; int n; float eps; } pc;
shared float red[256];
void main() {
    uint r = gl_WorkGroupID.x;
    if (r >= uint(pc.rows)) return;
    uint base = r * uint(pc.n);
    uint tid = gl_LocalInvocationID.x;
    for (uint i = tid; i < uint(pc.n); i += 256u) X[base + i] += D[base + i];
    // Retain the original materialized F32-add boundary, not an algebraic
    // add/norm rewrite. Every group owns a complete disjoint row of X.
    memoryBarrierBuffer();
    barrier();
    float local = 0.0;
    for (uint i = tid; i < uint(pc.n); i += 256u) {
        float v = X[base + i];
        local += v * v;
    }
    red[tid] = local;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (tid < s) red[tid] += red[tid + s];
        barrier();
    }
    float inv = inversesqrt(red[0] / float(pc.n) + pc.eps);
    for (uint i = tid; i < uint(pc.n); i += 256u) {
        Y[base + i] = X[base + i] * inv * W[i];
    }
}

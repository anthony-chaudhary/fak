#version 450
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_8bit_storage : require

// q8_matmul.comp — 2D block-tiled cooperative matrix GEMM for Q8_0 quantized matmul on Wave32 (gfx1151 / RDNA 3.5).
//
// Workgroups tile over (M=32 tokens, N=32 outputs) matching Wave32 subgroup dimensions on gfx1151.
// Activations X and weight codes Wcodes are cooperatively staged into LDS once per (M, N) tile
// over K-dimension windows of Q8_0 blocks (BLOCK=32).
//
// Within each workgroup (128 threads = 4 Wave32 wavefronts organized in a 2x2 grid):
//   - Wave (0,0): tokens [0..15], outputs [0..15]
//   - Wave (0,1): tokens [0..15], outputs [16..31]
//   - Wave (1,0): tokens [16..31], outputs [0..15]
//   - Wave (1,1): tokens [16..31], outputs [16..31]
//
// For each K-block of 32 weights:
//   1. Cooperatively stage 32 token rows of X (1024 floats) into LDS with Pad-2 stride (34 floats/row).
//   2. Cooperatively stage 32 output rows of Wcodes (1024 int8 codes) transposed into LDS [32 x 32].
//   3. Stage per-block scales Wscale (32 floats) into LDS.
//   4. Quantize X row-by-row into LDS Xq [32 x 34] int8 codes and per-row scale Xs [32].
//   5. Execute Wave32 WMMA 16x16x16 INT8 cooperative matrix multiply in two 16-element halves (K=0..15 and K=16..31),
//      accumulating into int32 registers.
//   6. Store cooperative matrix tile to LDS and accumulate scaled partial sums:
//      acc += float(dot) * Wscale * Xs.
//
// Finally, write back outputs Y[t * outDim + o] for valid (t < P && o < outDim).

layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

const uint TILE_M = 32u;
const uint TILE_N = 32u;
const uint BLOCK = 32u;
const uint LDS_PAD_2 = 2u;
const uint STRIDE_K = BLOCK + LDS_PAD_2;

shared int8_t  ldsXq[TILE_M * STRIDE_K];
shared int8_t  ldsTileW[BLOCK * TILE_N];
shared float   ldsXs[TILE_M];
shared float   ldsWs[TILE_N];
shared float   ldsX_f32[TILE_M * STRIDE_K];
shared int32_t ldsMatC[TILE_M * TILE_N];

layout(std430, binding = 0) readonly buffer Wq   { int8_t  Wcodes[]; };  // [out*in] int8 weight codes
layout(std430, binding = 1) readonly buffer Ws   { float   Wscale[]; };  // [out*nblk] per-block weight scales
layout(std430, binding = 2) readonly buffer Xb   { float   X[]; };       // [P*in] f32 activations
layout(std430, binding = 3) writeonly buffer Yb  { float   Y[]; };       // [P*out]

layout(push_constant) uniform Push { int outDim; int inDim; int P; } pc;

int8_t q8round(float x) {
    int t = int(x);
    float f = x - float(t);
    if (f >= 0.5) t += 1; else if (f <= -0.5) t -= 1;
    return int8_t(clamp(t, -127, 127));
}

void main() {
    uint waveID = gl_LocalInvocationID.y;
    uint laneID = gl_LocalInvocationID.x;
    uint threadID = waveID * 32u + laneID;

    uint waveRow = (waveID / 2u) * 16u;
    uint waveCol = (waveID % 2u) * 16u;

    uint tileRow = gl_WorkGroupID.y * TILE_M;
    uint tileCol = gl_WorkGroupID.x * TILE_N;

    uint in_ = uint(pc.inDim);
    uint out_ = uint(pc.outDim);
    uint P_ = uint(pc.P);
    uint nblk = in_ / BLOCK;

    float acc[8];
    for (uint i = 0u; i < 8u; ++i) {
        acc[i] = 0.0;
    }

    for (uint b = 0u; b < nblk; ++b) {
        // 1. Cooperatively load 32 rows of X into ldsX_f32
        for (uint i = threadID; i < 1024u; i += 128u) {
            uint r = i / 32u;
            uint c = i % 32u;
            uint gRow = tileRow + r;
            uint gCol = b * BLOCK + c;
            float val = 0.0;
            if (gRow < P_ && gCol < in_) {
                val = X[gRow * in_ + gCol];
            }
            ldsX_f32[r * STRIDE_K + c] = val;
        }

        // 2. Cooperatively stage Wcodes into ldsTileW [32 x 32] transposed: row=k, col=o
        for (uint i = threadID; i < 1024u; i += 128u) {
            uint o = i / 32u;
            uint k = i % 32u;
            uint gOut = tileCol + o;
            uint gIn = b * BLOCK + k;
            int8_t code = int8_t(0);
            if (gOut < out_ && gIn < in_) {
                code = Wcodes[gOut * in_ + gIn];
            }
            ldsTileW[k * TILE_N + o] = code;
        }

        // 3. Stage Wscale for the 32 outputs
        if (threadID < 32u) {
            uint gOut = tileCol + threadID;
            float s = 0.0;
            if (gOut < out_) {
                s = Wscale[gOut * nblk + b];
            }
            ldsWs[threadID] = s;
        }

        barrier();

        // 4. Quantize X row-by-row into ldsXq and ldsXs
        if (threadID < 32u) {
            uint r = threadID;
            uint gRow = tileRow + r;
            float amax = 0.0;
            if (gRow < P_) {
                for (uint k = 0u; k < 32u; ++k) {
                    amax = max(amax, abs(ldsX_f32[r * STRIDE_K + k]));
                }
            }
            float d = amax / 127.0;
            ldsXs[r] = d;
            float inv = d > 0.0 ? 1.0 / d : 0.0;
            for (uint k = 0u; k < 32u; ++k) {
                int8_t q = int8_t(0);
                if (d > 0.0) {
                    q = q8round(ldsX_f32[r * STRIDE_K + k] * inv);
                }
                ldsXq[r * STRIDE_K + k] = q;
            }
        }

        barrier();

        // 5. Cooperative matrix multiplication for this block
        coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA;
        coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB;
        coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC;
        matC = coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);

        for (uint kHalf = 0u; kHalf < 32u; kHalf += 16u) {
            uint offsetA = waveRow * STRIDE_K + kHalf;
            uint offsetB = kHalf * TILE_N + waveCol;

            coopMatLoad(matA, ldsXq, offsetA, STRIDE_K, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(matB, ldsTileW, offsetB, TILE_N, gl_CooperativeMatrixLayoutRowMajor);

            matC = coopMatMulAdd(matA, matB, matC);
        }

        uint offsetC = waveRow * TILE_N + waveCol;
        coopMatStore(matC, ldsMatC, offsetC, TILE_N, gl_CooperativeMatrixLayoutRowMajor);

        barrier();

        // 6. Accumulate scaled results
        for (uint i = 0u; i < 8u; ++i) {
            uint item = threadID * 8u + i;
            uint r = item / 32u;
            uint c = item % 32u;
            acc[i] += float(ldsMatC[r * TILE_N + c]) * ldsWs[c] * ldsXs[r];
        }

        barrier();
    }

    // 7. Write back outputs
    for (uint i = 0u; i < 8u; ++i) {
        uint item = threadID * 8u + i;
        uint r = item / 32u;
        uint c = item % 32u;
        uint gRow = tileRow + r;
        uint gOut = tileCol + c;
        if (gRow < P_ && gOut < out_) {
            Y[gRow * out_ + gOut] = acc[i];
        }
    }
}

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

// q2k_matmul.comp — GGML Q2_K 2-bit quantized matrix multiplication for Vulkan 1.2 / RADV.
//
// Y[P, outDim] = X[P, inDim] @ W[outDim, inDim]^T
//
// Q2_K superblock layout (256 weights, 84 bytes):
//   - scales: 16 bytes (offset 0..15; low 4 bits = scale mult, high 4 bits = min mult)
//   - qs:     64 bytes (offset 16..79; 256 2-bit codes, packed 4 per byte)
//   - d:      half (f16, offset 80..81)
//   - dmin:   half (f16, offset 82..83)
//
// One 32-lane workgroup owns one output row and a panel of up to four input tokens.
// Each lane evaluates eight weights per superblock (two 128-weight halves times four
// 32-weight groups), then subgroupAdd combines the partials. The panel keeps each
// dequantized weight resident while it is applied to four tokens, amortizing the Q2_K
// unpack and weight traffic during prefill without changing the P=1 decode path.

layout(local_size_x = 32) in;

layout(std430, set = 0, binding = 0) readonly buffer Q2K { uint raw[]; };
layout(std430, set = 0, binding = 1) readonly buffer X   { float x[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Y  { float y[]; };

layout(push_constant) uniform PC {
    int outDim;
    int inDim;
    int tokens;
} pc;

const uint TOKEN_TILE = 4u;

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint panel = gl_WorkGroupID.x / uint(pc.outDim);
    uint row = gl_WorkGroupID.x - panel * uint(pc.outDim);
    uint token0 = panel * TOKEN_TILE;
    if (row >= uint(pc.outDim) || token0 >= uint(pc.tokens)) return;

    uint blocks = uint(pc.inDim) / 256u;
    float sums[4] = float[4](0.0, 0.0, 0.0, 0.0);
    uint laneHalf = lane >> 4u;

    for (uint sb = 0u; sb < blocks; ++sb) {
        uint baseWord = (row * blocks + sb) * 21u; // 84-byte blocks are dword aligned.

        // Four lanes coalesce the 16-byte scale table. Each consumer shuffles the
        // required dword from its owning lane instead of issuing a divergent row load.
        uint scaleWord = lane < 4u ? raw[baseWord + lane] : 0u;

        // d and dmin occupy the final dword of the block. Load it once for the wave.
        uint dmWord = lane == 0u ? raw[baseWord + 20u] : 0u;
        dmWord = subgroupShuffle(dmWord, 0u);
        vec2 dm = unpackHalf2x16(dmWord);
        float d = dm.x;
        float minValue = dm.y;

        for (uint h = 0u; h < 2u; ++h) {
            // The 32 quant bytes for this half are eight consecutive dwords. Lanes
            // 0..7 issue the coalesced loads; subgroupShuffle distributes one byte
            // to each of the 32 arithmetic lanes.
            uint qWord = lane < 8u ? raw[baseWord + 4u + h * 8u + lane] : 0u;
            qWord = subgroupShuffle(qWord, lane >> 2u);
            uint qb = (qWord >> ((lane & 3u) * 8u)) & 0xffu;

            for (uint j = 0u; j < 4u; ++j) {
                uint scaleIndex = h * 8u + 2u * j + laneHalf;
                uint selectedScaleWord = subgroupShuffle(scaleWord, scaleIndex >> 2u);
                uint sc = (selectedScaleWord >> ((scaleIndex & 3u) * 8u)) & 0xffu;
                float dl = d * float(sc & 15u);
                float ml = minValue * float(sc >> 4u);
                uint code = (qb >> (2u * j)) & 3u;
                float weight = dl * float(code) - ml;
                uint k = sb * 256u + h * 128u + j * 32u + lane;

                for (uint m = 0u; m < TOKEN_TILE; ++m) {
                    uint token = token0 + m;
                    if (token < uint(pc.tokens)) {
                        sums[m] += weight * x[token * uint(pc.inDim) + k];
                    }
                }
            }
        }
    }

    for (uint m = 0u; m < TOKEN_TILE; ++m) {
        float total = subgroupAdd(sums[m]);
        uint token = token0 + m;
        if (lane == 0u && token < uint(pc.tokens)) {
            y[token * uint(pc.outDim) + row] = total;
        }
    }
}

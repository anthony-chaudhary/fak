#version 450

// q2k_matmul.comp - GGML Q2_K matrix multiplication for Vulkan 1.2 / RADV.
//
// One audited Q2_K decoder serves three modes selected by auxOutDim:
//    0: ordinary Y[P,outDim] = X[P,inDim] * W0[outDim,inDim]^T.
//   -1: decode-only Y += silu(X) * U * W0^T.
//   >0: decode-only RMSNorm(X) followed by W0 and W1 projections.
//
// Q2_K superblock layout (256 weights, 84 bytes):
//   scales 0..15, packed quants 16..79, d f16 80..81, dmin f16 82..83.
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Q2K   { uint raw[]; };
layout(std430, set = 0, binding = 1) readonly buffer X     { float x[]; };
layout(std430, set = 0, binding = 2) readonly buffer U     { float u[]; };
layout(std430, set = 0, binding = 3) buffer Y              { float y[]; };
layout(std430, set = 0, binding = 4) readonly buffer W1buf { uint raw1[]; };
layout(std430, set = 0, binding = 5) readonly buffer Nbuf  { float normWeight[]; };
layout(std430, set = 0, binding = 6) writeonly buffer Y1buf { float y1[]; };

layout(push_constant) uniform PC {
    int outDim;
    int inDim;
    int tokens;
    int auxOutDim;
    float eps;
} pc;

shared float fusedX[256];
shared float normRed[256];
shared float normalizedX[256];

uint byteAt(uint off) {
    uint w = raw[off >> 2];
    return (w >> ((off & 3u) * 8u)) & 255u;
}

uint byteAt(bool second, uint off) {
    uint w = second ? raw1[off >> 2] : raw[off >> 2];
    return (w >> ((off & 3u) * 8u)) & 255u;
}

float halfAt(uint off) {
    uint bits = byteAt(off) | (byteAt(off + 1u) << 8u);
    return unpackHalf2x16(bits).x;
}

float halfAt(bool second, uint off) {
    uint bits = byteAt(second, off) | (byteAt(second, off + 1u) << 8u);
    return unpackHalf2x16(bits).x;
}

float q2kDot(bool second, uint row, uint sb, float values[256]) {
    uint base = uint((row * uint(pc.inDim / 256) + sb) * 84u);
    float d = halfAt(second, base + 80u);
    float minVal = halfAt(second, base + 82u);
    float sum = 0.0;
    uint scaleIndex = 0u;
    uint quantOffset = 0u;
    for (int n = 0; n < 256; n += 128) {
        uint shift = 0u;
        for (int j = 0; j < 4; ++j) {
            uint sc0 = byteAt(second, base + scaleIndex++);
            uint sc1 = byteAt(second, base + scaleIndex++);
            float dl0 = d * float(sc0 & 15u);
            float ml0 = minVal * float(sc0 >> 4u);
            float dl1 = d * float(sc1 & 15u);
            float ml1 = minVal * float(sc1 >> 4u);
            uint qBase0 = base + 16u + quantOffset;
            uint qBase1 = qBase0 + 16u;
            uint valueBase = uint(n + j * 32);
            for (uint lane = 0u; lane < 16u; ++lane) {
                uint q0 = byteAt(second, qBase0 + lane);
                uint q1 = byteAt(second, qBase1 + lane);
                sum += (dl0 * float((q0 >> shift) & 3u) - ml0) * values[valueBase + lane];
                sum += (dl1 * float((q1 >> shift) & 3u) - ml1) * values[valueBase + 16u + lane];
            }
            shift += 2u;
        }
        quantOffset += 32u;
    }
    return sum;
}

void plainMatMul() {
    int globalIdx = int(gl_GlobalInvocationID.x);
    int row;
    int token;
    if (pc.tokens > 1 && gl_NumWorkGroups.y == 1u) {
        row = globalIdx % pc.outDim;
        token = globalIdx / pc.outDim;
    } else {
        row = int(gl_GlobalInvocationID.x);
        token = int(gl_GlobalInvocationID.y);
    }
    if (row >= pc.outDim || token >= pc.tokens) return;

    int blocks = pc.inDim / 256;
    float sum = 0.0;
    for (int sb = 0; sb < blocks; ++sb) {
        for (uint lane = 0u; lane < 256u; ++lane) {
            fusedX[lane] = x[uint(token * pc.inDim + sb * 256) + lane];
        }
        sum += q2kDot(false, uint(row), uint(sb), fusedX);
    }
    y[token * pc.outDim + row] = sum;
}

void fusedSwiGLUAdd() {
    uint tid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x * gl_WorkGroupSize.x + tid;
    bool valid = row < uint(pc.outDim);
    int blocks = pc.inDim / 256;
    float sum = 0.0;
    for (int sb = 0; sb < blocks; ++sb) {
        uint xBase = uint(sb * 256);
        float gate = x[xBase + tid];
        fusedX[tid] = (gate / (1.0 + exp(-gate))) * u[xBase + tid];
        barrier();
        if (valid) sum += q2kDot(false, row, uint(sb), fusedX);
        barrier();
    }
    if (valid) y[row] += sum;
}

void fusedRMSNormMatMul2() {
    uint tid = gl_LocalInvocationID.x;
    uint outputIndex = gl_WorkGroupID.x * gl_WorkGroupSize.x + tid;
    uint totalOut = uint(pc.outDim + pc.auxOutDim);
    bool validOutput = outputIndex < totalOut;
    bool second = outputIndex >= uint(pc.outDim);
    uint row = second ? outputIndex - uint(pc.outDim) : outputIndex;

    float local = 0.0;
    for (uint i = tid; i < uint(pc.inDim); i += gl_WorkGroupSize.x) {
        float value = x[i];
        local += value * value;
    }
    normRed[tid] = local;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) normRed[tid] += normRed[tid + stride];
        barrier();
    }
    float inv = inversesqrt(normRed[0] / float(pc.inDim) + pc.eps);

    int blocks = pc.inDim / 256;
    float sum = 0.0;
    for (int sb = 0; sb < blocks; ++sb) {
        uint index = uint(sb * 256) + tid;
        normalizedX[tid] = x[index] * inv * normWeight[index];
        barrier();
        if (validOutput) sum += q2kDot(second, row, uint(sb), normalizedX);
        barrier();
    }

    if (validOutput) {
        if (second) y1[row] = sum;
        else y[row] = sum;
    }
}

void main() {
    if (pc.auxOutDim == 0) plainMatMul();
    else if (pc.auxOutDim < 0 && pc.tokens == 1) fusedSwiGLUAdd();
    else if (pc.tokens == 1) fusedRMSNormMatMul2();
}

#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0)           buffer Xbuf { float X[]; };
layout(std430, binding = 1) readonly  buffer Gbuf { float Gate[]; };

layout(push_constant) uniform Push {
    int n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    float g = Gate[i];
    float sig = 1.0 / (1.0 + exp(-g));
    X[i] = X[i] * sig;
}
